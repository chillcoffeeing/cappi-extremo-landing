---
import Layout from '../layouts/Layout.astro';
import ComingSoonSection from '../components/sections/hero/ComingSoonSection.astro';
import { WHATSAPP_URL } from '../lib/social';
---

<Layout title="Inscripciones - Cappi Extremo" description="¿Quieres inscribir a tu hijo? Escríbenos por WhatsApp y te enviamos toda la información del plan vacacional.">

	<ComingSoonSection
		title="¿Quieres reservar un cupo?"
		description="Escríbenos por WhatsApp y te enviamos toda la información del plan vacacional: fechas, actividades y precio y todos los detalles. Si decides inscribir a tu hijo, ahí mismo te compartimos el link para registrarte y pagar."
		links={[
			{ label: 'Escribir por WhatsApp', href: WHATSAPP_URL, variant: 'primary' },
		]}
	/>

</Layout>
