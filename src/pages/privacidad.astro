---
import Layout from '../layouts/Layout.astro';
import LegalSection from '../components/sections/legal/LegalSection.astro';
import type { LegalSection as LegalSectionModel } from '../components/sections/legal/LegalSection.astro';

const sections: LegalSectionModel[] = [
	{
		heading: '1. Información que recopilamos',
		body: 'En Cappi Xtremo recopilamos únicamente la información necesaria para brindar nuestros servicios:',
		list: [
			'Datos de contacto (nombre, correo electrónico, teléfono)',
			'Información del niño (nombre, edad, alergias o condiciones médicas relevantes)',
			'Datos de pago para procesar inscripciones',
		],
	},
	{
		heading: '2. Uso de la información',
		body: 'Utilizamos tu información para:',
		list: [
			'Procesar inscripciones y pagos',
			'Comunicarnos contigo sobre el plan vacacional',
			'Garantizar la seguridad y bienestar de los campistas',
			'Mejorar nuestros servicios',
		],
	},
	{
		heading: '3. Protección de datos',
		body: 'Implementamos medidas de seguridad técnicas y organizativas para proteger tu información personal contra acceso no autorizado, alteración, divulgación o destrucción.',
	},
	{
		heading: '4. Compartir información',
		body: 'No vendemos ni compartimos tu información personal con terceros, excepto cuando sea necesario para cumplir con obligaciones legales o proveer servicios esenciales del plan vacacional.',
	},
	{
		heading: '5. Tus derechos',
		body: 'Tienes derecho a acceder, corregir o eliminar tu información personal en cualquier momento. Para ejercer estos derechos, contáctanos a través de nuestros canales oficiales.',
	},
	{
		heading: '6. Contacto',
		body: 'Si tienes preguntas sobre estas políticas, escríbenos a <a href="mailto:contacto@cappiextremo.com" class="text-secondary underline transition-colors hover:text-secondary/80">contacto@cappiextremo.com</a>.',
	},
];
---

<Layout title="Políticas de privacidad - Cappi Extremo" description="Conoce cómo recopilamos, usamos y protegemos tu información personal.">

	<LegalSection title="Políticas de privacidad" updated="Última actualización: enero 2027" sections={sections} />

</Layout>