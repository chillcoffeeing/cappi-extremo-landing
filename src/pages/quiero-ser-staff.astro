---
import Layout from '../layouts/Layout.astro';
import SectionHero from '../components/sections/hero/SectionHero.astro';
import SectionHeading from '../components/titles/SectionHeading.astro';
import SectionPattern from '../components/astro/SectionPattern.astro';
import CtaSection from '../components/sections/cta/CtaSection.astro';
import ModalComponent from '../components/modal/ModalComponent.astro';
import Button from '../components/buttons/Button.astro';
import ConsentCheckbox from '../components/forms/ConsentCheckbox.astro';
import TurnstileField from '../components/forms/TurnstileField.astro';
import {
	recruitmentCopy,
} from '../data/staff';
import { EMAIL_URL } from '../lib/social';

import heroBg from '../assets/gallery/team-full-view.jpg?url';
import ctaBg from '../assets/gallery/juegos-5.jpg?url';

interface StaffApplicationField {
	id: string;
	name: string;
	label: string;
	type: 'text' | 'tel' | 'email' | 'textarea';
	required?: boolean;
	autocomplete?: string;
	placeholder?: string;
	rows?: number;
}

const staffApplicationFields: StaffApplicationField[] = [
	{ id: 'staff-full-name', name: 'fullName', label: 'Nombre completo', type: 'text', required: true, autocomplete: 'name' },
	{ id: 'staff-phone', name: 'phone', label: 'Teléfono / WhatsApp', type: 'tel', required: true, autocomplete: 'tel' },
	{ id: 'staff-email', name: 'email', label: 'Correo electrónico', type: 'email', required: true, autocomplete: 'email' },
	{ id: 'staff-city', name: 'city', label: 'Ciudad', type: 'text', required: true, autocomplete: 'address-level2' },
	{ id: 'staff-experience', name: 'experience', label: 'Experiencia', type: 'textarea', placeholder: '¿Has trabajado antes con niños, en planes vacacionales o recreación?', rows: 4 },
	{ id: 'staff-availability', name: 'availability', label: 'Disponibilidad', type: 'textarea', required: true, placeholder: 'Fechas o temporadas en las que puedes trabajar', rows: 3 },
];

const inputClass = 'mt-1.5 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm text-neutral-900 transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary';
const textareaClass = `${inputClass} placeholder-neutral-400`;
---

<Layout
	title="Quiero ser Staff - Cappi Extremo"
	description="Forma parte del equipo Xtremo. Conoce nuestro proceso de selección y postúlate para ser parte de la familia Cappi Extremo."
>
	<SectionHero
		bgImage={heroBg}
		eyebrow={recruitmentCopy.eyebrow}
		title="¿Quieres ser parte del "
		highlight="Staff"
		titleAfter='?'
		subtitle="Formar parte del equipo Xtremo es formar parte de una comunidad que se prepara y se exige cada temporada."
		buttons={[{ label: 'Quiero ser parte del Staff', href: '#postulacion', variant: 'primary' }]}
		disfuminar="bottom"
	/>

	<section class="py-16 md:py-24">
		<div class="container">
			<SectionHeading
				eyebrow={recruitmentCopy.eyebrow}
				title="Quienes hacen posible "
				underline="la magia"
			/>
			<div class="mx-auto mt-8 max-w-3xl space-y-5 text-center leading-relaxed text-neutral-700">
				{recruitmentCopy.intros.map((intro) => <p data-motion="fade-up">{intro}</p>)}
			</div>
		</div>
	</section>

	<SectionPattern top="base-pattern" />
	<section class="relative z-10 isolate bg-sections py-16 md:py-24">
		<div class="container">
			<SectionHeading
				eyebrow="EL PROCESO XTREMO"
				title="Selección y "
				underline="capacitación"
				color="secondary"
			/>
			<div class="mt-12 grid gap-6 md:grid-cols-2">
				<div data-motion="fade-up" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm md:p-10">
					<h3 class="font-semibold text-primary">{recruitmentCopy.selectionEyebrow}</h3>
					<p class="mt-4 leading-relaxed text-neutral-700">{recruitmentCopy.selectionIntro}</p>
					<ul class="mt-5 space-y-3 text-neutral-700">
						{recruitmentCopy.selectionItems.map((item) => (
							<li class="flex gap-3"><span aria-hidden="true" class="mt-2 size-2 shrink-0 rounded-full bg-secondary"></span><span>{item}</span></li>
						))}
					</ul>
				</div>
				<div data-motion="fade-up" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm md:p-10">
					<h3 class="font-semibold text-primary">Capacitación</h3>
					<p class="mt-4 leading-relaxed text-neutral-700">{recruitmentCopy.trainingIntro}</p>
					<ul class="mt-5 space-y-3 text-neutral-700">
						{recruitmentCopy.trainingItems.map((item) => (
							<li class="flex gap-3"><span aria-hidden="true" class="mt-2 size-2 shrink-0 rounded-full bg-secondary"></span><span>{item}</span></li>
						))}
					</ul>
				</div>
			</div>

			<div class="mt-10 text-center">
				<Button type="button" variant="primary" size="default" label="Quiero ser parte del Staff" class="min-h-11" attrs={{ 'data-staff-trigger': '' }} />
			</div>
		</div>
	</section>
	<SectionPattern bottom="base-pattern" />

<ModalComponent id="staff-application-dialog" labelledBy="staff-dialog-title" closeLabel="Cerrar formulario" triggers="[data-staff-trigger]">
		<Fragment slot="header">
			<header class="bg-primary pr-16 py-6 md:pr-20 md:px-8">
				<div class="px-6 md:px-0">
					<p class="text-xs font-bold uppercase tracking-[0.16em] text-white">EL EQUIPO XTREMO</p>
					<h2 id="staff-dialog-title" class="mt-2 font-semibold text-white">Quiero ser parte del Staff</h2>
				</div>
			</header>
		</Fragment>

		<form data-staff-form data-mailto={EMAIL_URL} class="space-y-5 overflow-x-hidden px-6 py-6 md:px-8" novalidate>
			{staffApplicationFields.map((field) => (
				<div>
					<label for={field.id} class="block text-sm font-medium text-neutral-700">{field.label}</label>
					{field.type === 'textarea' ? (
						<textarea id={field.id} name={field.name} rows={field.rows ?? 4} required={field.required} placeholder={field.placeholder} autocomplete={field.autocomplete} class={textareaClass}></textarea>
					) : (
						<input id={field.id} name={field.name} type={field.type} required={field.required} autocomplete={field.autocomplete} placeholder={field.placeholder} class={inputClass} />
					)}
				</div>
			))}

			<ConsentCheckbox />
			<TurnstileField id="staff-application-turnstile" />
		
			<div class="flex flex-col-reverse items-stretch gap-3 sm:flex-row sm:items-center sm:justify-end">
				<Button type="button" variant="ghost" tone="primary" size="sm" label="Cancelar" class="min-h-11" attrs={{ 'data-modal-close': '' }} />
				<Button type="submit" variant="primary" size="sm" label="Enviar postulación" class="min-h-11" />
			</div>
		</form>
	</ModalComponent>

	<CtaSection
		variant="light"
		title="Únete a la familia "
		underline="Cappixtremo"
		titleAfter=""
		buttons={[
			{ label: 'Conoce nuestro staff', href: '/nuestro-staff', variant: 'link' },
			{ label: 'Contáctanos', href: '/contacto', variant:  'primary' },
		]}
		padding="large"
	/>
</Layout>

<script>
	const dialog = document.getElementById('staff-application-dialog');
	const form = document.querySelector<HTMLFormElement>('[data-staff-form]');

	if (dialog instanceof HTMLDialogElement && form) {
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			if (!window.cappiValidateTurnstile('staff-application-turnstile', 'staff-application-turnstile-error')) return;

			const values = new FormData(form);
			const body = [
				`Nombre completo: ${values.get('fullName') ?? ''}`,
				`Teléfono / WhatsApp: ${values.get('phone') ?? ''}`,
				`Correo electrónico: ${values.get('email') ?? ''}`,
				`Ciudad: ${values.get('city') ?? ''}`,
				`Experiencia: ${values.get('experience') ?? ''}`,
				`Disponibilidad: ${values.get('availability') ?? ''}`,
			].join('\n');
			const email = form.dataset.mailto;
			if (!email) return;

			if (dialog.open) dialog.close();
			window.location.href = `${email}?subject=${encodeURIComponent('Postulación Staff')}&body=${encodeURIComponent(body)}`;
		});
	}
</script>
