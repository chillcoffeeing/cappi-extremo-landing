---
import Layout from '../layouts/Layout.astro';
import SectionHero from '../components/sections/hero/SectionHero.astro';
import ProgramsSection from '../components/sections/cards/ProgramsSection.astro';
import type { Program } from '../components/sections/cards/ProgramsSection.astro';
import CtaSection from '../components/sections/cta/CtaSection.astro';
import SectionPattern from '../components/astro/SectionPattern.astro';

import heroBg from '../assets/gallery/fiesta-2.jpg?url';
import motosFullView1 from '../assets/gallery/motos-full-view-1.jpg';
import fiesta1 from '../assets/gallery/fiesta-1.jpg';
import juegos1 from '../assets/gallery/juegos-1.jpg';

const programs: Program[] = [
	{
		icon: 'motos',
		title: 'Plan vacacional',
		description: 'La experiencia completa de verano. De lunes a viernes, los campistas disfrutan de deportes, juegos de agua, circuitos de aventura, motos y talleres creativos. Incluye alimentación completa y supervisión profesional.',
		image: motosFullView1,
		features: ['Deportes y juegos de agua', 'Circuitos de aventura', 'Talleres creativos', 'Alimentación completa'],
		cta: 'Ver planes',
		href: '/planes-vacacionales',
	},
	{
		icon: 'fiesta',
		title: 'Fiestas y eventos',
		description: 'Cumpleaños, celebraciones y eventos especiales con animación profesional. Temáticas personalizadas, juegos, música y diversión garantizada para todos los niños.',
		image: fiesta1,
		features: ['Temáticas personalizadas', 'Animación profesional', 'Juegos y música', 'Espacios cubiertos'],
		cta: 'Solicitar cotización',
		href: '/contacto',
	},
	{
		icon: 'juegos',
		title: 'Animación y recreación',
		description: 'Servicios de animación para escuelas, empresas y organizaciones. Actividades recreativas, dinámicas de equipo y experiencias diseñadas para cada grupo.',
		image: juegos1,
		features: ['Dinámicas de equipo', 'Actividades para todas las edades', 'Eventos corporativos', 'Programas escolares'],
		cta: 'Solicitar cotización',
		href: '/contacto',
	},
];
---

<Layout title="Programas — Cappi Extremo" description="Conoce todos nuestros programas: planes vacacionales, fiestas temáticas y servicios de animación y recreación.">

	<SectionHero
		bgImage={heroBg}
		eyebrow="Cappi "
		eyebrowHighlight="Xtremo"
		title="Programas diseñados para la "
		highlight="diversión"
		subtitle="Desde planes vacacionales de verano hasta fiestas temáticas, cada programa está pensado para crear recuerdos inolvidables."
	/>

	<SectionPattern bottom="orange-pattern-fade" />

	<ProgramsSection programs={programs} />

	<SectionPattern top="blue-pattern" flipTop />
	<CtaSection
		variant="dark"
		title="¿No encontraste lo que "
		underline="buscabas"
		titleAfter="?"
		intro="Cada evento es único. Cuéntanos tu idea y diseñamos una experiencia a tu medida."
		buttons={[{ label: 'Contáctanos', href: '/contacto', variant: 'white' }]}
		circles={[{ side: 'left', position: 'bottom', size: 'large' }]}
	/>
	<SectionPattern bottom="orange-pattern" />

</Layout>