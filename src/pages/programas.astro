---
import Layout from '../layouts/Layout.astro';
import UnderlineStroke from '../components/astro/UnderlineStroke.astro';
import SectionPattern from '../components/astro/SectionPattern.astro';

import heroBg from '../assets/gallery/fiesta-2.jpg?url';
import motosFullView1 from '../assets/gallery/motos-full-view-1.jpg?url';
import fiesta1 from '../assets/gallery/fiesta-1.jpg?url';
import juegos1 from '../assets/gallery/juegos-1.jpg?url';

const programs = [
	{
		icon: 'motos',
		title: 'Plan vacacional',
		description: 'La experiencia completa de verano. De lunes a viernes, los campistas disfrutan de deportes, juegos de agua, circuitos de aventura, motos y talleres creativos. Incluye alimentación completa y supervisión profesional.',
		image: motosFullView1,
		features: ['Deportes y juegos de agua', 'Circuitos de aventura', 'Talleres creativos', 'Alimentación completa'],
		cta: 'Ver planes',
		href: '/campamentos',
	},
	{
		icon: 'fiesta',
		title: 'Fiestas y eventos',
		description: 'Cumpleaños, celebraciones y eventos especiales con animación profesional. Temáticas personalizadas, juegos, música y diversión garantizada para todos los niños.',
		image: fiesta1,
		features: ['Temáticas personalizadas', 'Animación profesional', 'Juegos y música', 'Espacios cubiertos'],
		cta: 'Solicitar cotización',
		href: '/contacto',
	},
	{
		icon: 'juegos',
		title: 'Animación y recreación',
		description: 'Servicios de animación para escuelas, empresas y organizaciones. Actividades recreativas, dinámicas de equipo y experiencias diseñadas para cada grupo.',
		image: juegos1,
		features: ['Dinámicas de equipo', 'Actividades para todas las edades', 'Eventos corporativos', 'Programas escolares'],
		cta: 'Solicitar cotización',
		href: '/contacto',
	},
];
---

<Layout title="Programas — Cappi Extremo" description="Conoce todos nuestros programas: planes vacacionales, fiestas temáticas y servicios de animación y recreación.">

	<!-- Hero -->
	<section class="relative z-10 isolate overflow-hidden">
		<img src={heroBg} alt="" aria-hidden="true" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover" />
		<div class="absolute inset-0 -z-10 bg-neutral-950/70" aria-hidden="true"></div>
		<div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-32 lg:px-8">
			<div class="flex flex-col items-center text-center">
				<p data-motion="fade-up" class="text-xl font-semibold uppercase tracking-wide text-white">Cappi <span class="text-primary">Xtremo</span></p>
				<h1 data-motion="fade-up" class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
					Programas diseñados para la <span class="text-primary">diversión</span>
				</h1>
				<p data-motion="fade-up" class="mt-6 max-w-2xl text-lg font-normal leading-relaxed text-white md:text-xl">
					Desde planes vacacionales de verano hasta fiestas temáticas, cada programa está pensado para crear recuerdos inolvidables.
				</p>
			</div>
		</div>
	</section>

	<SectionPattern bottom="orange-pattern-fade" />

	<!-- Programas -->
	<section class="py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="space-y-24">
				{programs.map((program, i) => (
					<div data-motion="fade-up" class:list={[
						"grid grid-cols-1 gap-10 items-center lg:grid-cols-2",
					]}>
						<div class:list={[i % 2 === 1 && "lg:order-2"]}>
							<p class="text-sm font-semibold uppercase tracking-widest text-primary">{program.icon === 'motos' ? 'Plan vacacional' : program.icon === 'fiesta' ? 'Eventos' : 'Recreación'}</p>
							<h3 class="mt-3 text-2xl font-semibold text-neutral-900 md:text-3xl lg:text-4xl">{program.title}</h3>
							<p class="mt-4 text-lg leading-relaxed text-neutral-600">{program.description}</p>
							<ul class="mt-6 space-y-3">
								{program.features.map((f) => (
									<li class="flex items-center gap-2 text-base text-neutral-600">
										<svg class="size-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M20 6 9 17l-5-5" />
										</svg>
										{f}
									</li>
								))}
							</ul>
							<a href={program.href} class="mt-8 inline-flex items-center justify-center rounded-full bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
								{program.cta}
							</a>
						</div>
						<div class:list={[i % 2 === 1 && "lg:order-1"]}>
							<div class="relative overflow-hidden rounded-2xl shadow-sm">
								<img src={program.image} alt={program.title} loading="lazy" class="h-64 w-full object-cover sm:h-80 lg:h-96" />
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<SectionPattern top="blue-pattern" flipTop />
	<section class="relative z-10 isolate bg-secondary py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 data-motion="fade-up" class="mx-auto max-w-3xl text-center text-3xl font-semibold text-secondary-foreground md:text-[40px] md:leading-tight">
				¿No encontraste lo que buscabas?
			</h2>
			<p data-motion="fade-up" class="mx-auto mt-4 max-w-[700px] text-center text-lg leading-relaxed text-secondary-foreground/85">
				Cada evento es único. Cuéntanos tu idea y diseñamos una experiencia a tu medida.
			</p>
			<div data-motion="fade-up" class="mt-10 flex flex-col items-center gap-4">
				<a href="/contacto" class="inline-flex items-center justify-center rounded-full bg-white px-8 py-3.5 text-base font-semibold text-neutral-900 transition-colors hover:bg-neutral-100">
					Contáctanos
				</a>
			</div>
		</div>
	</section>
	<SectionPattern bottom="orange-pattern" />

</Layout>
