---
import Layout from '../layouts/Layout.astro';
import UnderlineStroke from '../components/astro/UnderlineStroke.astro';
import SectionPattern from '../components/astro/SectionPattern.astro';

import heroBg from '../assets/gallery/fiesta-3.jpg?url';

const features = [
	{
		icon: 'dashboard',
		title: 'Dashboard personalizado',
		description: 'Veo todo sobre tu hijo en un solo lugar: actividad del día, galería de fotos, calendario y cuenta regresiva para el próximo plan vacacional.',
	},
	{
		icon: 'inscription',
		title: 'Inscripciones fáciles',
		description: 'Inscribe a tu hijo en cualquier plan vacacional o sesión directamente desde el portal. Selecciona fechas, plan y completa el proceso en minutos.',
	},
	{
		icon: 'payments',
		title: 'Pagos flexibles',
		description: 'Reporta pagos por Zelle, Binance, transferencia o efectivo. Sube tu comprobante y recibe confirmación. Planes de cuotas libres disponibles.',
	},
	{
		icon: 'health',
		title: 'Salud y seguridad',
		description: 'Registra alergias, condiciones médicas, contactos de emergencia y documentos. Todo listo antes de que empiece el plan vacacional.',
	},
	{
		icon: 'photos',
		title: 'Galería del día',
		description: 'Mira las fotos que el staff sube durante el plan vacacional. Revive los mejores momentos de la aventura de tu hijo.',
	},
	{
		icon: 'balance',
		title: 'Estado de cuenta',
		description: 'Consulta tu saldo, historial de pagos y próxima fecha límite. Todo transparente y actualizado en tiempo real.',
	},
];

const steps = [
	{ num: '1', title: 'Crea tu cuenta', description: 'Regístrate con tus datos como representante legal.' },
	{ num: '2', title: 'Registra a tu hijo', description: 'Completa el perfil con datos básicos, salud y contactos de emergencia.' },
	{ num: '3', title: 'Inscribe en un plan vacacional', description: 'Elige el plan vacacional, sesión y plan de pago que prefieras.' },
	{ num: '4', title: 'Reporta tu pago', description: 'Sube el comprobante y espera la verificación. ¡Listo!' },
];
---

<Layout title="Portal de Familias — Cappi Extremo" description="Gestiona inscripciones, pagos y sigue la experiencia de tu hijo desde nuestro portal exclusivo para padres.">

	<!-- Hero -->
	<section class="relative z-10 isolate overflow-hidden">
		<img src={heroBg} alt="" aria-hidden="true" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover" />
		<div class="absolute inset-0 -z-10 bg-neutral-950/70" aria-hidden="true"></div>
		<div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-32 lg:px-8">
			<div class="flex flex-col items-center text-center">
				<p data-motion="fade-up" class="text-xl font-semibold uppercase tracking-wide text-white">Portal de <span class="text-primary">Familias</span></p>
				<h1 data-motion="fade-up" class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
					Tu centro de comando para las <span class="text-primary">aventuras</span> de tu hijo
				</h1>
				<p data-motion="fade-up" class="mt-6 max-w-2xl text-lg font-normal leading-relaxed text-white md:text-xl">
					Inscribe, paga, revisa fotos y mantente al día con todo lo que pasa en el plan vacacional. Un solo lugar para las familias Cappi.
				</p>
				<div data-motion="fade-up" class="mt-10 flex flex-col items-center gap-4 sm:flex-row">
					<a href="/coming-soon" class="inline-flex items-center justify-center rounded-full bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
						Crear mi cuenta
					</a>
					<a href="/coming-soon" class="inline-flex items-center justify-center rounded-full bg-white px-8 py-3.5 text-base font-semibold text-neutral-900 transition-colors hover:bg-neutral-100">
						Iniciar sesión
					</a>
				</div>
			</div>
		</div>
	</section>

	<SectionPattern bottom="orange-pattern-fade" />

	<!-- Features -->
	<section class="py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<p data-motion="fade-up" class="text-center text-sm font-semibold uppercase tracking-widest text-primary">
				¿Qué puedes hacer?
			</p>
			<h2 data-motion="fade-up" class="mt-3 text-center text-3xl font-semibold text-neutral-900 md:text-[40px] md:leading-tight">
				Todo lo que necesitas, <UnderlineStroke>en un solo lugar</UnderlineStroke>
			</h2>

			<div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{features.map((f) => (
					<article data-motion="fade-up" class="rounded-2xl border border-neutral-200 p-8 shadow-sm transition-shadow hover:shadow-md">
						<div class="flex size-12 items-center justify-center rounded-full bg-primary/10">
							{f.icon === 'dashboard' && (
								<svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect width="7" height="9" x="3" y="3" rx="1" /><rect width="7" height="5" x="14" y="3" rx="1" /><rect width="7" height="9" x="14" y="12" rx="1" /><rect width="7" height="5" x="3" y="16" rx="1" />
								</svg>
							)}
							{f.icon === 'inscription' && (
								<svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" x2="19" y1="8" y2="14" /><line x1="22" x2="16" y1="11" y2="11" />
								</svg>
							)}
							{f.icon === 'payments' && (
								<svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect width="20" height="14" x="2" y="5" rx="2" /><line x1="2" x2="22" y1="10" y2="10" />
								</svg>
							)}
							{f.icon === 'health' && (
								<svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
								</svg>
							)}
							{f.icon === 'photos' && (
								<svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
								</svg>
							)}
							{f.icon === 'balance' && (
								<svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
								</svg>
							)}
						</div>
						<h3 class="mt-5 text-lg font-semibold text-neutral-900">{f.title}</h3>
						<p class="mt-2 text-base leading-relaxed text-neutral-600">{f.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- Cómo funciona -->
	<SectionPattern top="blue-pattern" flipTop />
	<section class="relative z-10 isolate bg-secondary py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<p data-motion="fade-up" class="text-center text-sm font-semibold uppercase tracking-widest text-secondary-foreground">
				¿Cómo funciona?
			</p>
			<h2 data-motion="fade-up" class="mt-3 text-center text-3xl font-semibold uppercase text-secondary-foreground md:text-[40px] md:leading-tight">
				<UnderlineStroke color="text-primary" nowrap={false}>4 pasos sencillos</UnderlineStroke>
			</h2>

			<div class="mx-auto mt-14 grid max-w-4xl grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
				{steps.map((s) => (
					<div data-motion="fade-up" class="flex flex-col items-center text-center">
						<div class="flex size-14 items-center justify-center rounded-full bg-primary text-xl font-bold text-primary-foreground">
							{s.num}
						</div>
						<h3 class="mt-4 text-lg font-semibold text-secondary-foreground">{s.title}</h3>
						<p class="mt-2 text-base text-secondary-foreground/85">{s.description}</p>
					</div>
				))}
			</div>

			<div data-motion="fade-up" class="mt-12 flex flex-col items-center gap-4">
				<a href="/coming-soon" class="inline-flex items-center justify-center rounded-full bg-white px-8 py-3.5 text-base font-semibold text-neutral-900 transition-colors hover:bg-neutral-100">
					Comenzar ahora
				</a>
			</div>
		</div>
	</section>
	<SectionPattern bottom="orange-pattern" />

	<!-- CTA final -->
	<section class="py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-3xl text-center">
				<h2 data-motion="fade-up" class="text-3xl font-semibold text-neutral-900 md:text-[40px] md:leading-tight">
					¿Listo para empezar?
				</h2>
				<p data-motion="fade-up" class="mt-4 text-lg leading-relaxed text-neutral-600">
					Crea tu cuenta y descubre todo lo que el portal de familias tiene para ti. Es rápido, seguro y gratuito.
				</p>
				<div data-motion="fade-up" class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
					<a href="/coming-soon" class="inline-flex items-center justify-center rounded-full bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
						Crear mi cuenta
					</a>
					<a href="/planes-vacacionales" class="inline-flex items-center justify-center rounded-full border border-neutral-300 px-8 py-3.5 text-base font-semibold text-neutral-800 transition-colors hover:border-primary hover:text-primary">
						Ver planes vacacionales
					</a>
				</div>
			</div>
		</div>
	</section>

</Layout>
