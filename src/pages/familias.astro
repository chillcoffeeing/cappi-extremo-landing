---
import Layout from '../layouts/Layout.astro';
import SectionHero from '../components/sections/hero/SectionHero.astro';
import FeaturesSection from '../components/sections/cards/FeaturesSection.astro';
import StepsSection from '../components/sections/steps/StepsSection.astro';
import CtaSection from '../components/sections/cta/CtaSection.astro';
import type { FeatureItem } from '../components/sections/cards/FeaturesSection.astro';
import type { Step } from '../components/sections/steps/StepsSection.astro';
import SectionPattern from '../components/astro/SectionPattern.astro';

import heroBg from '../assets/gallery/fiesta-3.jpg?url';

const features: FeatureItem[] = [
	{
		icon: 'dashboard',
		title: 'Dashboard personalizado',
		description: 'Veo todo sobre tu hijo en un solo lugar: actividad del día, galería de fotos, calendario y cuenta regresiva para el próximo plan vacacional.',
	},
	{
		icon: 'inscription',
		title: 'Inscripciones fáciles',
		description: 'Inscribe a tu hijo en cualquier plan vacacional o sesión directamente desde el portal. Selecciona fechas, plan y completa el proceso en minutos.',
	},
	{
		icon: 'payments',
		title: 'Pagos flexibles',
		description: 'Reporta pagos por Zelle, Binance, transferencia o efectivo. Sube tu comprobante y recibe confirmación. Planes de cuotas libres disponibles.',
	},
	{
		icon: 'health',
		title: 'Salud y seguridad',
		description: 'Registra alergias, condiciones médicas, contactos de emergencia y documentos. Todo listo antes de que empiece el plan vacacional.',
	},
	{
		icon: 'photos',
		title: 'Galería del día',
		description: 'Mira las fotos que el staff sube durante el plan vacacional. Revive los mejores momentos de la aventura de tu hijo.',
	},
	{
		icon: 'balance',
		title: 'Estado de cuenta',
		description: 'Consulta tu saldo, historial de pagos y próxima fecha límite. Todo transparente y actualizado en tiempo real.',
	},
] satisfies FeatureItem[];

const steps: Step[] = [
	{ number: '1', title: 'Crea tu cuenta', description: 'Regístrate con tus datos como representante legal.' },
	{ number: '2', title: 'Registra a tu hijo', description: 'Completa el perfil con datos básicos, salud y contactos de emergencia.' },
	{ number: '3', title: 'Inscribe en un plan vacacional', description: 'Elige el plan vacacional, sesión y plan de pago que prefieras.' },
	{ number: '4', title: 'Reporta tu pago', description: 'Sube el comprobante y espera la verificación. ¡Listo!' },
];
---

<Layout title="Portal de Familias — Cappi Extremo" description="Gestiona inscripciones, pagos y sigue la experiencia de tu hijo desde nuestro portal exclusivo para padres.">

	<SectionHero
		bgImage={heroBg}
		eyebrow="Portal de "
		eyebrowHighlight="Familias"
		title="Tu centro de comando para las "
		highlight="aventuras"
		titleAfter=" de tu hijo"
		subtitle="Inscribe, paga, revisa fotos y mantente al día con todo lo que pasa en el plan vacacional. Un solo lugar para las familias Cappi."
		buttons={[
			{ label: 'Crear mi cuenta', href: '/coming-soon', variant: 'primary' },
			{ label: 'Iniciar sesión', href: '/coming-soon', variant: 'white' },
		]}
	/>

	<SectionPattern bottom="orange-pattern-fade" />

	<FeaturesSection
		eyebrow="¿Qué puedes hacer?"
		title="Todo lo que necesitas, en un "
		underline="solo lugar"
		items={features}
	/>

	<SectionPattern top="blue-pattern" flipTop />
	<StepsSection
		eyebrow="¿Cómo funciona?"
		title="4 "
		underline="pasos sencillos"
		steps={steps}
		columns={4}
		cta={{ label: 'Comenzar ahora', href: '/coming-soon', variant: 'white' }}
		circles={[
			{ side: 'left', position: 'top' },
			{ side: 'right', position: 'bottom' },
		]}
	/>
	<SectionPattern bottom="blue-pattern" flipBottom />

	<CtaSection
		variant="light"
		title="¿Listo para empezar?"
		intro="Crea tu cuenta y descubre todo lo que el portal de familias tiene para ti. Es rápido, seguro y gratuito."
		buttons={[
			{ label: 'Crear mi cuenta', href: '/coming-soon', variant: 'primary' },
			{ label: 'Ver planes vacacionales', href: '/planes-vacacionales', variant: 'outline' },
		]}
	/>

</Layout>