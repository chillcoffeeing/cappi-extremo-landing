---
import Layout from '../layouts/Layout.astro';
import SectionHero from '../components/sections/hero/SectionHero.astro';
import PhilosophySection from '../components/sections/cards/PhilosophySection.astro';
import ServicesBand from '../components/sections/cta/ServicesBand.astro';
import ActivitiesSection from '../components/sections/cards/ActivitiesSection.astro';
import TestimonialsSection from '../components/sections/testimonials/TestimonialsSection.astro';
import GallerySection from '../components/sections/gallery/GallerySection.astro';
import StaffSection from '../components/sections/cards/StaffSection.astro';
import FaqSection from '../components/sections/faq/FaqSection.astro';
import CtaSection from '../components/sections/cta/CtaSection.astro';
import type { ServiceCard } from '../components/sections/cta/ServicesBand.astro';
import type { PhilosophyItem } from '../components/sections/cards/PhilosophySection.astro';
import type { ActivityItem } from '../components/sections/cards/ActivitiesSection.astro';
import type { GalleryImage } from '../components/sections/gallery/GallerySection.astro';
import SectionPattern from '../components/astro/SectionPattern.astro';
import { testimonials } from '../data/testimonials';
import { faqs } from '../data/faqs';

import flagIcon from '../assets/ui/flag.svg?url';
import peopleIcon from '../assets/ui/people.svg?url';
import laughIcon from '../assets/ui/laugh.svg?url';
import shieldIcon from '../assets/ui/shield.svg?url';

import heroPosterBg from '../assets/gallery/motos-full-view-2.jpg?url';
import heroVideoMp4Bg from '../assets/videos/hero-video-bg.mp4?url';
import motosFullView1 from '../assets/gallery/motos-full-view-1.jpg?url';
import fiesta1 from '../assets/gallery/fiesta-1.jpg?url';
import juegos1 from '../assets/gallery/juegos-1.jpg?url';
import teamFullView from '../assets/gallery/team-full-view.jpg?url';

import h1 from '../assets/gallery/all/horizontal-images/IMG_3594.jpg?url';
import h2 from '../assets/gallery/all/horizontal-images/IMG_4595.jpg?url';
import h3 from '../assets/gallery/all/horizontal-images/IMG_4593.jpg?url';
import h4 from '../assets/gallery/all/horizontal-images/IMG_4578.jpg?url';
import h5 from '../assets/gallery/all/horizontal-images/IMG_4576.jpg?url';
import h6 from '../assets/gallery/all/horizontal-images/IMG_4565.jpg?url';
import h7 from '../assets/gallery/all/horizontal-images/IMG_4213.jpg?url';
import h8 from '../assets/gallery/all/horizontal-images/IMG_4198.jpg?url';
import v1 from '../assets/gallery/all/vertical-images/IMG_5611.jpg?url';
import v2 from '../assets/gallery/all/vertical-images/IMG_5610.jpg?url';
import v3 from '../assets/gallery/all/vertical-images/IMG_5592.jpg?url';
import v4 from '../assets/gallery/all/vertical-images/IMG_5584.jpg?url';
import v5 from '../assets/gallery/all/vertical-images/IMG_5571.jpg?url';
import v6 from '../assets/gallery/all/vertical-images/IMG_5568.jpg?url';
import v7 from '../assets/gallery/all/vertical-images/IMG_5554.jpg?url';
import v8 from '../assets/gallery/all/vertical-images/IMG_5549.jpg?url';

import activity1 from '../assets/gallery/padel-fest.jpg?url';
import activity2 from '../assets/gallery/paseo-a-caballo.jpg?url';
import activity3 from '../assets/gallery/acuatico.jpg?url';
import activity4 from '../assets/gallery/deportes.jpg?url';
import activity5 from '../assets/gallery/spa.jpg?url';
import activity6 from '../assets/gallery/rally-barro.jpg?url';
import activity7 from '../assets/gallery/var-ritmo.jpg?url';
import activity8 from '../assets/gallery/planetario.jpg?url';
import activity9 from '../assets/gallery/rusticos.jpg?url';



const NEXT_CAMP_START = '2027-06-15T09:00:00-04:00';

const COLORS = { col1: '#805611', col2: '#59802E', col3: '#026A80' };

const serviceCards: ServiceCard[] = [
	{ image: motosFullView1, title: 'Planes vacacionales', cta: 'Ver nuestros planes vacacionales', href: '/planes-vacacionales' },
	{ image: fiesta1, title: 'Fiestas y eventos', cta: 'Ver servicio', href: '/otros-servicios' },
	{ image: juegos1, title: 'Animación y recreación', cta: 'Ver servicio', href: '/otros-servicios' },
];

const philosophyItems: PhilosophyItem[] = [
	{ icon: flagIcon, title: 'Aventura sin límites', description: 'Actividades al aire libre que sacan lo mejor de cada niño.' },
	{ icon: peopleIcon, title: 'Amistades para toda la vida', description: 'Un ambiente donde se hacen amigos de verdad.' },
	{ icon: laughIcon, title: 'Aprender jugando', description: 'Cada actividad enseña algo, sin que se sienta como clase.' },
	{ icon: shieldIcon, title: 'Seguridad ante todo', description: 'Personal capacitado y protocolos claros en cada momento.' },
];

const activitiesCards: ActivityItem[] = [
	{ image: activity1, title: 'Pádel Fest', color: COLORS.col1 },
	{ image: activity2, title: 'Paseo a caballo', color: COLORS.col2 },
	{ image: activity3, title: 'Acuático', color: COLORS.col3 },
	{ image: activity4, title: 'Deportes', color: COLORS.col1 },
	{ image: activity5, title: 'Spa', color: COLORS.col2 },
	{ image: activity6, title: 'Rally barro', color: COLORS.col3 },
	{ image: activity7, title: 'VAR ritmo', color: COLORS.col1 },
	{ image: activity8, title: 'Planetario', color: COLORS.col2 },
	{ image: activity9, title: 'Rústicos', color: COLORS.col3 },
];

const galleryRow1: GalleryImage[] = [
	{ src: h1, alt: 'Actividades al aire libre en Cappi Xtremo' },
	{ src: h2, alt: 'Grupo de niños disfrutando aventuras' },
	{ src: h3, alt: 'Deportes y juegos extremos' },
	{ src: h4, alt: 'Experiencia vacacional inolvidable' },
	{ src: h5, alt: 'Niños en actividad recreativa' },
	{ src: h6, alt: 'Circuito de aventura en el parque' },
	{ src: h7, alt: 'Aventura y diversión para todos' },
	{ src: h8, alt: 'Momentos de diversión en Cappi' },
];

const galleryRow2: GalleryImage[] = [
	{ src: v1, alt: 'Niño conduciendo cuatriciclo' },
	{ src: v2, alt: 'Actividades deportivas en equipo' },
	{ src: v3, alt: 'Juegos de agua y aventura' },
	{ src: v4, alt: 'Exploración y descubrimiento' },
	{ src: v5, alt: 'Nuevos amigos en el plan vacacional' },
	{ src: v6, alt: 'Talleres creativos al aire libre' },
	{ src: v7, alt: 'Circuitos de obstáculos' },
	{ src: v8, alt: 'Energía y diversión sin parar' },
];
---

<Layout>
	<SectionHero
		bgImage={heroPosterBg}
		bgVideo={heroVideoMp4Bg}
		bgVideoPoster={heroPosterBg}
		eyebrow="Cappi "
		eyebrowHighlight="Xtremo"
		title="¡Las vacaciones más "
		highlight="divertidas"
		titleAfter=" están por comenzar!"
		subtitle="Deporte, amigos, aventura y risas sin parar. Dale a tu hijo un verano que va a recordar para siempre."
		buttons={[
			{ label: 'Ver fechas y plan vacacional', href: '/planes-vacacionales', variant: 'primary' },
			{ label: 'Únete ahora', href: '#', variant: 'white' },
		]}
		dock
	/>
	<SectionPattern bottom="orange-pattern-fade" />

	<PhilosophySection
		title="Nuestra "
		underline="filosofía"
		intro="En Cappi Xtremo creemos que el verano es para vivirlo a fondo: correr, jugar, ensuciarse y hacer amigos para toda la vida. Por eso cada día está diseñado para que tu hijo se divierta, se atreva y crezca."
		items={philosophyItems}
		cta={{ label: 'Conoce nuestros planes vacacionales', href: '/planes-vacacionales' }}
	/>

	<SectionPattern top="orange-pattern" flipTop />
	<ServicesBand
		headingTitle="Bienvenidos a "
		underline="Cappi Xtremo"
		intro="Conoce nuestros servicios y todo lo que podemos hacer por ti. Planes vacacionales, eventos, fiestas y animaciones para celebrar por todo lo alto."
		cards={serviceCards}
		countdownId="camp-countdown"
		countdownTarget={NEXT_CAMP_START}
		countdownSize="hero"
		ctas={[
			{ label: 'Apartar cupo para mi hijo', href: '/planes-vacacionales', variant: 'white' },
			{ label: 'Ver detalles del plan vacacional', href: '/planes-vacacionales', variant: 'link' },
		]}
	/>
	<SectionPattern bottom="orange-pattern" />

	<ActivitiesSection
		eyebrow="Actividades"
		underline="Jugadas extremas"
		intro="Cada día trae un reto distinto: deporte, agua, aire libre y mucha creatividad. Mientras se divierten, los campistas también desarrollan liderazgo, trabajo en equipo, confianza y respeto a su propio ritmo y sin darse cuenta."
		items={activitiesCards}
	/>

	<TestimonialsSection
		eyebrow="Testimonios"
		title="Lo que dicen "
		underline="las familias"
		items={testimonials}
	/>

	<GallerySection
		eyebrow="Galería"
		title="Así se vive "
		underline="Cappi Xtremo"
		intro="Cada foto cuenta una aventura distinta, la próxima puede ser la de tu hijo."
		introClass="max-w-175"
		rows={[
			{ images: galleryRow1, direction: 'left' },
			{ images: galleryRow2, direction: 'right' },
		]}
	/>

	<StaffSection
		eyebrow="Nuestro staff"
		title="El equipo "
		underline="Cappi"
		intro="Todo nuestro equipo pasa por un proceso de selección, verificación y entrenamiento en primeros auxilios antes de estar frente a los campistas. Conoce al equipo que acompaña a tu hijo cada día."
		image={teamFullView}
		imageAlt="El equipo de monitores y coordinadores de Cappi Xtremo"
	/>

	<SectionPattern top="blue-pattern" flipTop />
	<FaqSection
		tone="dark"
		eyebrow="Respondemos tus dudas"
		title="Preguntas "
		underline="frecuentes"
		items={faqs}
		circles={[
			{ side: 'left', position: 'center' },
			{ side: 'right', position: 'bottom', size: 'large' },
		]}
	/>

	<CtaSection
		variant="image"
		bgImage={motosFullView1}
		title="¿Tienes preguntas sobre nuestros "
		underline="planes vacacionales"
		titleAfter="? Escríbenos."
		buttons={[{ label: 'Contáctanos', href: '/contacto', variant: 'white' }]}
		padding="large"
	/>

</Layout>