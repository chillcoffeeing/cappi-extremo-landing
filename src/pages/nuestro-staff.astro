---
import Layout from '../layouts/Layout.astro';
import SectionHero from '../components/sections/hero/SectionHero.astro';
import ImageAccent from '../components/astro/ImageAccent.astro';
import StaffTeamRow from '../components/sections/staff/StaffTeamRow.astro';
import type { StaffTeam } from '../components/sections/staff/StaffTeamRow.astro';

import heroBg from '../assets/gallery/staff/hero.webp?url';
import brujulaImg from '../assets/gallery/staff/brujula.webp?url';
import radarImg from '../assets/gallery/staff/radar-extremo.webp?url';
import farosImg from '../assets/gallery/staff/faros.webp?url';
import focoImg from '../assets/gallery/staff/foco-xtremo.webp?url';
import sonreirImg from '../assets/gallery/staff/sonreir-jugando.png?url';
import underlineStroke from '../assets/gallery/staff/underline.svg?url';
import SectionPattern from '../components/astro/SectionPattern.astro';

const overlay30 = 'bg-gradient-to-b from-primary/30 to-secondary/30';

const brujula: StaffTeam = {
	id: 'brujula',
	name: 'Brújula',
	paragraphs: [
		'Son los coordinadores y el norte de nuestro equipo. Su misión es mantener el rumbo en cada jornada, guiando a nuestros guías, velando por la seguridad y asegurando que cada actividad fluya con alegría, orden y propósito. La Brújula conecta, organiza y está atenta a cada detalle para que nuestros participantes vivan una experiencia inolvidable',
	],
	image: radarImg,
	imageAlt: 'Dos coordinadoras de Cappi Xtremo acostadas en la grama, sonriendo',
	imagePosition: 'object-[center_38%]',
	overlay: overlay30,
};

const radar: StaffTeam = {
	id: 'radar-extremo',
	name: 'Radar Extremo',
	paragraphs: [
		'Es la dirección estratégica y el corazón operativo de nuestro plan vacacional. Se encarga de monitorear cada detalle antes, durante y después de la experiencia: desde la logística general y la seguridad integral, hasta el rendimiento de los equipos y la toma de decisiones en tiempo real. Como un radar activo 24/7, nuestra directiva detecta oportunidades, anticipa cualquier reto y garantiza que el estándar de excelencia, la protección y la diversión se mantengan al máximo nivel en cada aventura.',
	],
	image: brujulaImg,
	imageAlt: 'Equipo directivo de Cappi Xtremo',
	overlay: 'bg-gradient-to-b from-primary/40 to-secondary/40',
};

const faros: StaffTeam = {
	id: 'nuestros-faros',
	name: 'Nuestros Faros',
	paragraphs: [
		'Son los guías que acompañan, cuidan e iluminan cada paso de nuestros campistas. Con su energía desbordante, empatía y entusiasmo, son la luz brillante que enciende la diversión, inspira confianza y sostiene la alegría del grupo en todo momento.',
		'Los Faros guían con el ejemplo, crean vínculos inolvidables y garantizan que nadie se pierda la aventura.',
	],
	image: farosImg,
	imageAlt: 'Guías de Cappi Xtremo acostados en la grama formando un círculo',
	overlay: overlay30,
	reverse: true,
};

const foco: StaffTeam = {
	id: 'foco-xtremo',
	name: 'FocoXtremo',
	paragraphs: [
		'Es el equipo creativo encargado de capturar y proyectar la esencia, la emoción y la magia de nuestro plan vacacional. Su misión es enfocar cada sonrisa, documentar las grandes aventuras en tiempo real y conectar a las familias con la vivencia de sus hijos a través de fotos y videos inolvidables.',
		'Con Foco Extremo, nada se pasa por alto y cada momento se convierte en un recuerdo que trasciende.',
	],
	image: focoImg,
	imageAlt: 'Equipo creativo de Cappi Xtremo posando juntos',
	overlay: 'bg-[linear-gradient(178deg,rgba(0,128,128,0.3)_1%,rgba(255,127,80,0.3)_72%)]',
};
---

<Layout
	title="Nuestro Staff - Cappi Extremo"
	description="Conoce al equipo Xtremo: las personas que preparan, acompañan y hacen posible cada experiencia de Cappi Extremo."
>
	<ImageAccent color="tertiary" position="bottom" align="right">
		<SectionHero
			bgImage={heroBg}
			bgMediaPosition="top"
			eyebrow="CAPPI XTREMO"
			italic
			title="Las manos que conectan cada sonrisa"
			subtitle="Personas que, desde distintos roles, ponen el corazón para que cada participante viva días que va a recordar para siempre."
		/>
	</ImageAccent>

	<!-- Intro -->
	<div class="px-4 pt-14 md:pt-[87px]">
		<div data-motion="fade-up" class="mx-auto max-w-[949px] space-y-6 text-center text-black">
			<p class="font-light leading-normal md:text-lg">
				Detrás de cada Jugada Extrema hay una familia: personas que, desde distintos roles, ponen el corazón para que cada participante viva días que va a recordar para siempre. Desde la Dirección hasta cada Facilitador en cancha, todos compartimos algo simple pero profundo, creemos que conectando sonrisas, se crea familia.
			</p>
			<p class="font-light leading-normal md:text-lg">
				Ser parte de la familia Xtremo es mucho más que un trabajo. Es sumarse a una comunidad que crece junto a cada niño que pasa por nuestros planes vacacionales, que se prepara temporada tras temporada para seguir mereciendo la confianza que cada familia nos regala.
			</p>
		</div>
	</div>

	<!-- Equipo: Radar Extremo -->
	<div class="px-4 pb-20 pt-14 md:pb-[138px] md:pt-20">
		<StaffTeamRow team={radar} />
	</div>

	<!-- Banda: Hacemos sonreír, jugando -->
	<SectionPattern top="base-pattern" additionalClasses={['text-primary']} />
	<div class="relative isolate flex min-h-[420px] items-end py-20 sm:items-center overflow-hidden bg-primary md:h-[457px] lg:min-h-[600px]">
		<img
			src={sonreirImg}
			alt="Dos integrantes del staff jugando, una sobre la espalda de la otra"
			loading="lazy"
			decoding="async"
			class="absolute bottom-0 left-0 -z-10 h-[95%] w-auto object-contain object-bottom opacity-60 md:h-[435px] lg:h-[570px] md:opacity-100"
		/>
		<div aria-hidden="true" class="absolute inset-0 -z-10 bg-primary/20"></div>

		<div data-motion="fade-up" class="relative px-4 text-center sm:text-left sm:ml-[calc(35%+60px)] lg:ml-[calc(44%)] xl:container xl:pl-[500px] 2xl:pl-[300px] md:w-auto md:px-0">
			<h2 class="leading-none mx-auto">
				<span class="block font-black uppercase text-white text-[2rem] sm:text-[2.10rem] md:text-[40px] lg:text-[55px] 2xl:text-[65px]">Hacemos sonreír,</span>
				<span class="block font-sansita-swashed font-black text-secondary text-[3.5rem] md:-mt-1 md:text-[55px] lg:text-[85px]">Jugando</span>
			</h2>
			<img src={underlineStroke} alt="" aria-hidden="true" width="400" height="14" class="mt-3 h-auto w-[240px] mx-auto sm:mx-0 md:mt-4 md:w-[250px] lg:w-[340px]" />
		</div>
	</div>
	<SectionPattern bottom="base-pattern" additionalClasses={['text-primary']} />
	
	<!-- Equipos -->
	<div class="px-4 py-14 md:py-[120px]">
		<StaffTeamRow team={brujula} />
	</div>
	
	<SectionPattern top="base-pattern" additionalClasses={['text-sections']} />
	<div class="bg-sections px-4 py-14 md:py-[125px]">
		<StaffTeamRow team={faros} />
	</div>
	<SectionPattern bottom="base-pattern" additionalClasses={['text-sections']} />

	<div class="px-4 py-14 md:py-[126px]">
		<StaffTeamRow team={foco} />
	</div>
</Layout>
