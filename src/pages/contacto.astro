---
import Layout from '../layouts/Layout.astro';
import SectionHero from '../components/sections/hero/SectionHero.astro';
import ContactSection from '../components/sections/contact/ContactSection.astro';
import type { ScheduleEntry } from '../components/sections/contact/ContactSection.astro';
import SectionPattern from '../components/astro/SectionPattern.astro';

import heroBg from '../assets/gallery/juegos-1.jpg?url';

const schedule: ScheduleEntry[] = [
	{ range: 'Lunes a viernes', hours: '9:00 - 18:00' },
	{ range: 'Sábados', hours: '9:00 - 14:00' },
	{ range: 'Domingos', hours: 'Cerrado', dimmed: true },
];
---

<Layout title="Contacto — Cappi Extremo" description="¿Tienes preguntas? Contáctanos por WhatsApp, correo o llena nuestro formulario. Estamos para ayudarte.">

	<SectionHero
		bgImage={heroBg}
		eyebrow="Cappi "
		eyebrowHighlight="Xtremo"
		title="¿Tienes "
		highlight="preguntas"
		titleAfter="? Estamos para ayudarte"
		subtitle="Escríbenos por WhatsApp, correo o llena el formulario y te respondemos lo antes posible."
	/>

	<SectionPattern bottom="orange-pattern-fade" />

	<ContactSection schedule={schedule} />

</Layout>