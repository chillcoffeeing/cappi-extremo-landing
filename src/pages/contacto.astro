---
import Layout from '../layouts/Layout.astro';
import UnderlineStroke from '../components/astro/UnderlineStroke.astro';
import SectionPattern from '../components/astro/SectionPattern.astro';
import { WHATSAPP_URL, EMAIL_URL } from '../lib/social';

import heroBg from '../assets/gallery/juegos-1.jpg?url';
---

<Layout title="Contacto — Cappi Extremo" description="¿Tienes preguntas? Contáctanos por WhatsApp, correo o llena nuestro formulario. Estamos para ayudarte.">

	<!-- Hero -->
	<section class="relative z-10 isolate overflow-hidden">
		<img src={heroBg} alt="" aria-hidden="true" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover" />
		<div class="absolute inset-0 -z-10 bg-neutral-950/70" aria-hidden="true"></div>
		<div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-32 lg:px-8">
			<div class="flex flex-col items-center text-center">
				<p data-motion="fade-up" class="text-xl font-semibold uppercase tracking-wide text-white">Cappi <span class="text-primary">Xtremo</span></p>
				<h1 data-motion="fade-up" class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
					¿Tienes <span class="text-primary">preguntas</span>? Estamos para ayudarte
				</h1>
				<p data-motion="fade-up" class="mt-6 max-w-2xl text-lg font-normal leading-relaxed text-white md:text-xl">
					Escríbenos por WhatsApp, correo o llena el formulario y te respondemos lo antes posible.
				</p>
			</div>
		</div>
	</section>

	<SectionPattern bottom="orange-pattern-fade" />

	<!-- Formulario + datos -->
	<section class="py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-2">

				<!-- Formulario -->
				<div>
					<p data-motion="fade-up" class="text-sm font-semibold uppercase tracking-widest text-primary">
						Escríbenos
					</p>
					<h2 data-motion="fade-up" class="mt-3 text-3xl font-semibold text-neutral-900 md:text-[40px] md:leading-tight">
						Formulario de <UnderlineStroke>contacto</UnderlineStroke>
					</h2>
					<p data-motion="fade-up" class="mt-4 text-lg leading-relaxed text-neutral-600">
						Cuéntanos en qué te podemos ayudar y te responderemos a la brevedad.
					</p>

					<form data-motion="fade-up" class="mt-8 space-y-5" action="#" method="POST">
						<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
							<div>
								<label for="name" class="block text-sm font-medium text-neutral-700">Nombre</label>
								<input type="text" id="name" name="name" required class="mt-1.5 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" placeholder="Tu nombre" />
							</div>
							<div>
								<label for="email" class="block text-sm font-medium text-neutral-700">Correo</label>
								<input type="email" id="email" name="email" required class="mt-1.5 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" placeholder="tu@correo.com" />
							</div>
						</div>
						<div>
							<label for="subject" class="block text-sm font-medium text-neutral-700">Asunto</label>
							<select id="subject" name="subject" class="mt-1.5 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm text-neutral-900 transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
								<option>Inscripción plan vacacional</option>
								<option>Cotización fiesta o evento</option>
								<option>Otra pregunta</option>
							</select>
						</div>
						<div>
							<label for="message" class="block text-sm font-medium text-neutral-700">Mensaje</label>
							<textarea id="message" name="message" rows="5" required class="mt-1.5 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" placeholder="Cuéntanos en qué te podemos ayudar..."></textarea>
						</div>
						<button data-motion="fade-up" type="submit" class="inline-flex items-center justify-center rounded-full bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
							Enviar mensaje
						</button>
					</form>
				</div>

				<!-- Datos de contacto -->
				<div class="flex flex-col gap-8 lg:pl-12">
					<div data-motion="fade-up">
						<h3 class="text-xl font-semibold text-neutral-900">Contacto directo</h3>
						<p class="mt-3 text-lg leading-relaxed text-neutral-600">
							Si prefieres hablar con nosotros directamente, usa cualquiera de estos canales.
						</p>
					</div>

					<div class="space-y-4">
						<a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" data-motion="fade-up" class="flex items-center gap-4 rounded-2xl border border-neutral-200 p-6 transition-colors hover:border-primary/50 hover:bg-primary/5">
							<div class="flex size-14 items-center justify-center rounded-full bg-primary/10">
								<svg class="size-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1zm0 0a5 5 0 0 0 5 5m0 0a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1h1z" />
								</svg>
							</div>
							<div>
								<p class="font-semibold text-neutral-900">WhatsApp</p>
								<p class="text-sm text-neutral-500">Respuesta inmediata</p>
							</div>
						</a>

						<a href={EMAIL_URL} data-motion="fade-up" class="flex items-center gap-4 rounded-2xl border border-neutral-200 p-6 transition-colors hover:border-primary/50 hover:bg-primary/5">
							<div class="flex size-14 items-center justify-center rounded-full bg-secondary/10">
								<svg class="size-7 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2Z" /><path d="m22 6-10 7L2 6" />
								</svg>
							</div>
							<div>
								<p class="font-semibold text-neutral-900">Correo electrónico</p>
								<p class="text-sm text-neutral-500">Te respondemos en 24 horas</p>
							</div>
						</a>
					</div>

					<div data-motion="fade-up" class="rounded-2xl bg-secondary/10 p-6">
						<h4 class="font-semibold text-neutral-900">Horario de atención</h4>
						<ul class="mt-4 space-y-3 text-base text-neutral-600">
							<li class="flex justify-between"><span>Lunes a viernes</span><span class="font-medium text-neutral-900">9:00 - 18:00</span></li>
							<li class="flex justify-between"><span>Sábados</span><span class="font-medium text-neutral-900">9:00 - 14:00</span></li>
							<li class="flex justify-between"><span>Domingos</span><span class="font-medium text-neutral-500">Cerrado</span></li>
						</ul>
					</div>
				</div>

			</div>
		</div>
	</section>

</Layout>
