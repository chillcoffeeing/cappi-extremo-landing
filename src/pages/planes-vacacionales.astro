---
import Layout from '../layouts/Layout.astro';
import SectionHero from '../components/sections/hero/SectionHero.astro';
import CountdownSection from '../components/sections/schedule/CountdownSection.astro';
import PlansSection from '../components/sections/pricing/PlansSection.astro';
import SessionsSection from '../components/sections/schedule/SessionsSection.astro';
import GallerySection from '../components/sections/gallery/GallerySection.astro';
import TestimonialsSection from '../components/sections/testimonials/TestimonialsSection.astro';
import CtaSection from '../components/sections/cta/CtaSection.astro';
import type { Plan } from '../components/sections/pricing/PlansSection.astro';
import type { Session } from '../components/sections/schedule/SessionsSection.astro';
import type { GalleryImage } from '../components/sections/gallery/GallerySection.astro';
import SectionPattern from '../components/astro/SectionPattern.astro';
import { testimonials } from '../data/testimonials';

import heroBg from '../assets/gallery/motos-full-view-1.jpg?url';
import ctaBg from '../assets/gallery/fiesta-2.jpg?url';
import motosFullView2 from '../assets/gallery/motos-full-view-2.jpg';
import juegos1 from '../assets/gallery/juegos-1.jpg';

const NEXT_CAMP_START = '2027-06-15T09:00:00-04:00';

const plans: Plan[] = [
	{
		name: 'Plan Vacacional Decembrino',
		price: '$150',
		period: 'por semana',
		startDate: 'XX/XX/XXX',
		features: ['Experiencia completa de lunes a viernes', 'Almuerzo, meriendas y cena', 'Aventuras, motos y juegos extremos', 'Planes vacacionales especiales temáticos', 'Fotografías del plan vacacional'],
		cta: 'Reserva cupo a mi hijo',
		highlight: true,
		image: motosFullView2,
		slug: 'vacacional',
	},
	{
		name: 'Daycamp',
		price: 'Próximamente',
		period: '',
		features: ['Actividades diarias de 9am a 3pm', 'Almuerzo y meriendas incluidas', 'Deportes, juegos y talleres', 'Personal capacitado en primeros auxilios'],
		cta: 'Inscribir ahora',
		highlight: false,
		disabled: true,
		image: juegos1,
		slug: 'daycamp',
	},
];

const sessions: Session[] = [
	{ name: 'Semana 1', dates: '15 - 19 de junio', status: 'Disponible' },
	{ name: 'Semana 2', dates: '22 - 26 de junio', status: 'Disponible' },
	{ name: 'Semana 3', dates: '29 de junio - 3 de julio', status: 'Disponible' },
	{ name: 'Semana 4', dates: '6 - 10 de julio', status: 'Por confirmar' },
];

const galleryModules = import.meta.glob(
	'../assets/gallery/all/**/*.{jpg,jpeg,png,webp,avif,gif}',
	{ eager: true, query: '?url', import: 'default' },
) as Record<string, string>;

const allGalleryImages: GalleryImage[] = Object.entries(galleryModules).map(([, src]) => ({
	src,
	alt: 'Experiencia Cappi Xtremo',
}));

const galleryRow1: GalleryImage[] = allGalleryImages.slice(0, Math.ceil(allGalleryImages.length / 2));
const galleryRow2: GalleryImage[] = allGalleryImages.slice(Math.ceil(allGalleryImages.length / 2));
---

<Layout title="Planes vacacionales - Cappi Extremo" description="Conoce nuestros planes vacacionales y daycamp. Inscripciones abiertas para el próximo verano.">

	<SectionHero
		bgImage={heroBg}
		bgColor="bg-sections"
		eyebrow="Cappi "
		eyebrowHighlight="Xtremo"
		title="Elige el plan perfecto para las "
		highlight="vacaciones"
		titleAfter=" de tu hijo"
		disfuminar="bottom"
		subtitle="Daycamp y plan vacacional. Todas nuestras opciones incluyen seguridad, diversión y memorias inolvidables."
	/>

	<CountdownSection
		title="Cuenta regresiva del próximo plan vacacional"
		target={NEXT_CAMP_START}
		ctas={[
			{ label: 'Apartar cupo para mi hijo', href: '/coming-soon', variant: 'white' },
			{ label: 'Ver detalles del plan vacacional', href: '/planes-vacacionales/vacacional', variant: 'link' },
		]}
	/>
	<SectionPattern bottom="base-pattern"  />

	<PlansSection
		eyebrow="Nuestros planes"
		title="Planes "
		underline="vacacionales"
		intro="Cada plan está diseñado para que tu hijo viva una experiencia completa de diversión, aventura y aprendizaje."
		plans={plans}
		inscribirHref="/coming-soon"
	/>

	<SectionPattern top="base-pattern"  />
	<SessionsSection
		tone="dark"
		eyebrow="Fechas disponibles"
		title="Sesiones "
		underline="2027"
		sessions={sessions}
		ctas={[
			{ label: 'Inscribir a mi hijo', href: '/coming-soon', variant: 'white' },
			{ label: 'Tengo preguntas', href: '/contacto', variant: 'link' },
		]}
	/>
	<SectionPattern bottom="base-pattern"  />


	<GallerySection
		eyebrow="Galería"
		title="Así se viven los "
		underline="planes vacacionales"
		intro="Momentos reales de diversión, aventura y aprendizaje vividos por los niños en Cappi Xtremo."
		rows={[
			{ images: galleryRow1, direction: 'left' },
			{ images: galleryRow2, direction: 'right' },
		]}
	/>

	<TestimonialsSection
		eyebrow="Comentarios"
		title="Lo que dicen las "
		underline="familias"
		items={testimonials}
		compactHeading
	/>

	<CtaSection
		variant="image"
		disfuminar='bottom'
		bgImage={ctaBg}
		title="¿Listo para que tu hijo viva la "
		underline="mejor experiencia"
		titleAfter="?"
		buttons={[{ label: 'Contáctanos', href: '/contacto', variant: 'white' }]}
		padding="large"
/>

</Layout>