---
import Layout from '../layouts/Layout.astro';
import SectionHero from '../components/sections/hero/SectionHero.astro';
import SectionPattern from '../components/astro/SectionPattern.astro';
import CtaSection from '../components/sections/cta/CtaSection.astro';
import CountdownSection from '../components/sections/schedule/CountdownSection.astro';
import InclusionsBandSection from '../components/sections/cta/InclusionsBandSection.astro';
import ActivitiesSection from '../components/sections/cards/ActivitiesSection.astro';
import type { Pill, IncludedItem } from '../components/sections/cta/InclusionsBandSection.astro';
import type { ActivityItem } from '../components/sections/cards/ActivitiesSection.astro';
import { christmasVacationPlan } from '../data/plan-vacacional';

import heroBg from '../assets/gallery/motos-2.jpg?url';

const plan = christmasVacationPlan;

const inclusionPills: Pill[] = [
	{ text: plan.date, fat: false },
	{ text: plan.hours, fat: true },
	{ text: plan.ages, fat: false },
];

const inclusionsItems: IncludedItem[] = [
	{ label: 'Franela', icon: 'lucide:shirt' },
	{ label: 'Transporte', icon: 'lucide:bus' },
	{ label: 'Almuerzo', icon: 'lucide:utensils' },
	{ label: 'Merienda PM', icon: 'lucide:coffee' },
	{ label: 'Hidratación', icon: 'lucide:droplets' },
	{ label: 'Materiales', icon: 'lucide:paintbrush' },
	{ label: 'Juegos recreativos', icon: 'lucide:volleyball' },
	{ label: 'Staff Calificado', icon: 'lucide:users' },
	{ label: 'Seguridad', icon: 'lucide:shield-check' },
	{ label: 'Servicio Médico', icon: 'lucide:stethoscope' },
	{ label: '9h diarias por 5 días', icon: 'lucide:clock' },
];

const activitiesCards: ActivityItem[] = [
	{ title: 'Paintball hidrogel (para los grandes)', icon: 'lucide:crosshair' },
	{ title: 'Cuatrimotos', icon: 'lucide:motorbike' },
	{ title: 'Tirolesa', icon: 'lucide:mountain' },
	{ title: 'Rally', icon: 'lucide:route' },
	{ title: 'Carta de Navidad', icon: 'lucide:mail' },
	{ title: 'Piscina', icon: 'lucide:waves' },
	{ title: 'Gymcanas', icon: 'lucide:puzzle' },
	{ title: 'Deportes', icon: 'lucide:dumbbell' },
	{ title: 'Manualidades', icon: 'lucide:scissors' },
	{ title: 'Competencias', icon: 'lucide:trophy' },
	{ title: 'Sorpresas', icon: 'lucide:gift' },
];
---

<Layout
	title="Plan Vacacional - Edición Navidad - Cappi Extremo"
	description="Conoce el Plan Vacacional - Edición Navidad de Cappi Xtremo: cinco días de actividades, diversión y acompañamiento para niños de 4 a 15 años."
>
	<SectionHero
		bgImage={heroBg}
		eyebrow="PLAN VACACIONAL"
		title="PLAN VACACIONAL - "
		highlight="EDICIÓN NAVIDAD"
		subtitle={`${plan.date} · ${plan.hours} · ${plan.ages}`}
		buttons={[{ label: 'Reservar cupo', href: plan.registrationUrl, variant: 'primary' }]}
		disfuminar="bottom"
	/>

	<CountdownSection
		title="Cuenta regresiva del plan vacacional"
		target="2026-12-14T08:00:00-04:00"
		countdownId="pv-countdown"
	/>
	
	<SectionPattern top="base-pattern" />

	<InclusionsBandSection
		pills={inclusionPills}
		location={plan.location}
		items={inclusionsItems}
		cta={{ label: 'Reservar cupo', href: plan.registrationUrl }}
	/>
	
	<SectionPattern bottom="base-pattern" />
	

	<ActivitiesSection
		eyebrow="Actividades"
		title="Una semana de "
		underline="aventuras"
		intro="Cada jornada combina movimiento, creatividad, juego y sorpresas para que cada participante encuentre su propia jugada extrema."
		items={activitiesCards}
		padding="large"
	/>

	<CtaSection
		variant="light"
		title="Reservar "
		underline="cupo"
		titleAfter=""
		intro={`Reserva la experiencia de Navidad en ${plan.registrationUrl.replace('https://', '')}. También puedes encontrarnos en Instagram: ${plan.instagramHandle}.`}
		buttons={[
			{ label: 'Cappixtremo.com', href: plan.registrationUrl, variant: 'primary' },
			{ label: `Instagram ${plan.instagramHandle}`, href: plan.instagramUrl, variant: 'link' },
		]}
		padding="large"
	/>
</Layout>