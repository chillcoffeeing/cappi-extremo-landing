---
import Layout from '../../layouts/Layout.astro';
import SectionHero from '../../components/sections/hero/SectionHero.astro';
import ActivitiesSection from '../../components/sections/cards/ActivitiesSection.astro';
import WoodBandSection from '../../components/sections/cta/WoodBandSection.astro';
import PriceSection from '../../components/sections/pricing/PriceSection.astro';
import SessionsSection from '../../components/sections/schedule/SessionsSection.astro';
import GallerySection from '../../components/sections/gallery/GallerySection.astro';
import TestimonialsSection from '../../components/sections/testimonials/TestimonialsSection.astro';
import StepsSection from '../../components/sections/steps/StepsSection.astro';
import FaqSection from '../../components/sections/faq/FaqSection.astro';
import CtaSection from '../../components/sections/cta/CtaSection.astro';
import type { ActivityItem } from '../../components/sections/cards/ActivitiesSection.astro';
import type { Pill, IncludedItem } from '../../components/sections/cta/WoodBandSection.astro';
import type { Session } from '../../components/sections/schedule/SessionsSection.astro';
import type { Step } from '../../components/sections/steps/StepsSection.astro';
import type { GalleryImage } from '../../components/sections/gallery/GallerySection.astro';
import SectionPattern from '../../components/astro/SectionPattern.astro';
import { faqs } from '../../data/faqs';
import { testimonials } from '../../data/testimonials';

import heroBg from '../../assets/gallery/motos-full-view-1.jpg?url';
import ctaBg from '../../assets/gallery/fiesta-3.jpg?url';

import h1 from '../../assets/gallery/all/horizontal-images/IMG_3594.jpg?url';
import h2 from '../../assets/gallery/all/horizontal-images/IMG_4595.jpg?url';
import h3 from '../../assets/gallery/all/horizontal-images/IMG_4593.jpg?url';
import h4 from '../../assets/gallery/all/horizontal-images/IMG_4578.jpg?url';
import h5 from '../../assets/gallery/all/horizontal-images/IMG_4576.jpg?url';
import h6 from '../../assets/gallery/all/horizontal-images/IMG_4565.jpg?url';
import h7 from '../../assets/gallery/all/horizontal-images/IMG_4213.jpg?url';
import h8 from '../../assets/gallery/all/horizontal-images/IMG_4198.jpg?url';
import v1 from '../../assets/gallery/all/vertical-images/IMG_5611.jpg?url';
import v2 from '../../assets/gallery/all/vertical-images/IMG_5610.jpg?url';
import v3 from '../../assets/gallery/all/vertical-images/IMG_5592.jpg?url';
import v4 from '../../assets/gallery/all/vertical-images/IMG_5584.jpg?url';
import v5 from '../../assets/gallery/all/vertical-images/IMG_5571.jpg?url';
import v6 from '../../assets/gallery/all/vertical-images/IMG_5568.jpg?url';
import v7 from '../../assets/gallery/all/vertical-images/IMG_5554.jpg?url';
import v8 from '../../assets/gallery/all/vertical-images/IMG_5549.jpg?url';

import activity1 from '../../assets/gallery/padel-fest.jpg?url';
import activity2 from '../../assets/gallery/paseo-a-caballo.jpg?url';
import activity3 from '../../assets/gallery/acuatico.jpg?url';
import activity4 from '../../assets/gallery/deportes.jpg?url';
import activity5 from '../../assets/gallery/spa.jpg?url';
import activity6 from '../../assets/gallery/rally-barro.jpg?url';
import activity7 from '../../assets/gallery/var-ritmo.jpg?url';
import activity8 from '../../assets/gallery/planetario.jpg?url';
import activity9 from '../../assets/gallery/rusticos.jpg?url';

export function getStaticPaths() {
	return [
		{ params: { slug: 'daycamp' } },
		{ params: { slug: 'vacacional' } },
	];
}

interface PlanData {
	name: string;
	summary: string;
	price: string;
	period: string;
	features: string[];
	schedule: string;
	mealsIncluded: string;
	mainActivities: string;
	notIncluded: string[];
}

const plans: Record<string, PlanData> = {
	daycamp: {
		name: 'Daycamp',
		summary: 'Actividades diarias llenas de energía, deporte y nuevos amigos',
		price: 'Próximamente',
		period: '',
		features: [
			'Actividades diarias de 9am a 3pm',
			'Almuerzo y meriendas incluidas',
			'Deportes, juegos y talleres',
			'Personal capacitado en primeros auxilios',
		],
		schedule: '9:00 AM - 3:00 PM',
		mealsIncluded: 'Almuerzo y meriendas',
		mainActivities: 'Deportes, juegos de agua, talleres creativos, circuitos de aventura',
		notIncluded: ['Transporte', 'Útiles escolares para talleres'],
	},
	vacacional: {
		name: 'Vacacional',
		summary: 'Experiencia completa de lunes a viernes con aventura, motos y juegos extremos',
		price: '$150',
		period: 'por semana',
		features: [
			'Experiencia completa de lunes a viernes',
			'Almuerzo, meriendas y cena',
			'Aventuras, motos y juegos extremos',
			'Planes vacacionales especiales temáticos',
			'Fotografías del plan vacacional',
		],
		schedule: '9:00 AM - 5:00 PM',
		mealsIncluded: 'Almuerzo, meriendas y cena',
		mainActivities: 'Motos, circuitos de aventura, juegos extremos, actividades temáticas, tiempo en equipo',
		notIncluded: ['Transporte'],
	},
};

const sessions: Session[] = [
	{ name: 'Semana 1', dates: '15 - 19 de junio', status: 'Disponible' },
	{ name: 'Semana 2', dates: '22 - 26 de junio', status: 'Disponible' },
	{ name: 'Semana 3', dates: '29 de junio - 3 de julio', status: 'Disponible' },
	{ name: 'Semana 4', dates: '6 - 10 de julio', status: 'Por confirmar' },
];

const steps: Step[] = [
	{ number: '1', title: 'Crea tu cuenta', description: 'Regístrate en nuestro portal de familias.' },
	{ number: '2', title: 'Registra a tu hijo', description: 'Agrega los datos de tu hijo en minutos.' },
	{ number: '3', title: 'Elige la sesión', description: 'Selecciona la semana que prefieras.' },
	{ number: '4', title: 'Reporta tu pago', description: 'Zelle, Binance, transferencia o efectivo.' },
];

const galleryRow1: GalleryImage[] = [
	{ src: h1, alt: 'Actividades al aire libre en Cappi Xtremo' },
	{ src: h2, alt: 'Grupo de niños disfrutando aventuras' },
	{ src: h3, alt: 'Deportes y juegos extremos' },
	{ src: h4, alt: 'Experiencia vacacional inolvidable' },
	{ src: h5, alt: 'Niños en actividad recreativa' },
	{ src: h6, alt: 'Circuito de aventura en el parque' },
	{ src: h7, alt: 'Aventura y diversión para todos' },
	{ src: h8, alt: 'Momentos de diversión en Cappi' },
];

const galleryRow2: GalleryImage[] = [
	{ src: v1, alt: 'Niño conduciendo cuatriciclo' },
	{ src: v2, alt: 'Actividades deportivas en equipo' },
	{ src: v3, alt: 'Juegos de agua y aventura' },
	{ src: v4, alt: 'Exploración y descubrimiento' },
	{ src: v5, alt: 'Nuevos amigos en el plan vacacional' },
	{ src: v6, alt: 'Talleres creativos al aire libre' },
	{ src: v7, alt: 'Circuitos de obstáculos' },
	{ src: v8, alt: 'Energía y diversión sin parar' },
];

const COLORS = { col1: '#805611', col2: '#59802E', col3: '#026A80' };

const activitiesCards: ActivityItem[] = [
	{ image: activity1, title: 'Pádel Fest', color: COLORS.col1 },
	{ image: activity2, title: 'Paseo a caballo', color: COLORS.col2 },
	{ image: activity3, title: 'Acuático', color: COLORS.col3 },
	{ image: activity4, title: 'Deportes', color: COLORS.col1 },
	{ image: activity5, title: 'Spa', color: COLORS.col2 },
	{ image: activity6, title: 'Rally barro', color: COLORS.col3 },
	{ image: activity7, title: 'VAR ritmo', color: COLORS.col1 },
	{ image: activity8, title: 'Planetario', color: COLORS.col2 },
	{ image: activity9, title: 'Rústicos', color: COLORS.col3 },
];

const horarioPills: Pill[] = [
	{ text: '7:30 am - 5:00 pm', fat: false },
	{ text: '+58 414-123-4567', fat: true },
	{ text: 'Edad: 5 a 15 años', fat: false },
];

const includedItems: IncludedItem[] = [
	{
		label: 'Almuerzo',
		color: 'primary',
		icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 8h16a1 1 0 0 1 1 1v.5c0 1.5 -2.517 5.573 -4 6.5v1a1 1 0 0 1 -1 1h-8a1 1 0 0 1 -1 -1v-1c-1.687 -1.054 -4 -5 -4 -6.5v-.5a1 1 0 0 1 1 -1z" />`,
	},
	{
		label: 'Merienda',
		color: 'secondary',
		icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 14c.83 .642 2.077 1.017 3.5 1c1.423 .017 2.67 -.358 3.5 -1c.83 -.642 2.077 -1.017 3.5 -1c1.423 -.017 2.67 .358 3.5 1" /><path d="M8 3a2.4 2.4 0 0 0 -1 2a2.4 2.4 0 0 0 1 2" /><path d="M12 3a2.4 2.4 0 0 0 -1 2a2.4 2.4 0 0 0 1 2" /><path d="M3 10h14v5a6 6 0 0 1 -6 6h-2a6 6 0 0 1 -6 -6v-5z" /><path d="M16.746 16.726a3 3 0 1 0 .252 -5.555" />`,
	},
	{
		label: 'Franela',
		color: 'tertiary',
		icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M15 4l6 2v5h-3v8a1 1 0 0 1 -1 1h-10a1 1 0 0 1 -1 -1v-8h-3v-5l6 -2a3 3 0 0 0 6 0" />`,
	},
	{
		label: 'Sorpresa',
		color: 'wood',
		icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 8m0 1a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1z" /><path d="M12 8l0 13" /><path d="M19 12v7a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-7" /><path d="M7.5 8a2.5 2.5 0 0 1 0 -5a4.8 8 0 0 1 4.5 5a4.8 8 0 0 1 4.5 -5a2.5 2.5 0 0 1 0 5" />`,
	},
	{
		label: 'Cuotas flexibles',
		color: 'primary',
		icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 5m0 3a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3z" /><path d="M3 10l18 0" /><path d="M7 15l.01 0" /><path d="M11 15l2 0" />`,
	},
];

const { slug } = Astro.params;
const plan = plans[slug as string];

if (!plan) {
	return Astro.redirect('/planes-vacacionales');
}

const title = `${plan.name} — Cappi Extremo`;
const description = `${plan.summary}. Inscripciones abiertas para el próximo verano en Cappi Xtremo.`;
---

<Layout title={title} description={description}>

	<SectionHero
		bgImage={heroBg}
		crumbs={[{ label: 'Planes vacacionales', href: '/planes-vacacionales' }, { label: plan.name }]}
		title={plan.name}
		subtitle={plan.summary}
		buttons={[{ label: 'Inscribir ahora a mi hijo', href: '/coming-soon', variant: 'primary' }]}
		titleMargin={false}
		disfuminar="bottom"
	/>

	<ActivitiesSection
		eyebrow="Actividades"
		underline="¿Qué incluye?"
		intro="Cada día trae un reto distinto: deporte, agua, aire libre y mucha creatividad. Mientras se divierten, los campistas también desarrollan liderazgo, trabajo en equipo, confianza y respeto a su propio ritmo y sin darse cuenta."
		items={activitiesCards}
		padding="large"
	/>

	<WoodBandSection
		pills={horarioPills}
		location="Finca la Esperanza - Guanare"
		items={includedItems}
		cta={{ label: 'Inscribir ahora a mi hijo', href: '/coming-soon' }}
	/>
	

	<PriceSection
		price={plan.price}
		period={plan.period}
		description="Paga completo o en cuotas. Aceptamos Zelle, Binance, transferencia bancaria o efectivo."
		cta={{ label: 'Inscribir ahora', href: '/coming-soon' }}
	/>
	<SectionPattern bottom="base-pattern"  />

	<SessionsSection
		tone="light"
		eyebrow="Calendario"
		title="Fechas "
		underline="y calendario"
		sessions={sessions}
		inscribirHref="/coming-soon"
	/>

	<GallerySection
		eyebrow="Galería"
		title="Así se viven las vacaciones en "
		underline="Cappi Xtremo"
		rows={[
			{ images: galleryRow1, direction: 'left' },
			{ images: galleryRow2, direction: 'right' },
		]}
	/>

	<TestimonialsSection
		eyebrow="Testimonios"
		title="Lo que dicen "
		underline="las familias"
		items={testimonials}
		padding="large"
	/>

	<SectionPattern top="base-pattern" />
	<StepsSection
	eyebrow="¿Cómo inscribirte?"
	title="4 "
	underline="pasos sencillos"
	steps={steps}
	columns={4}
	/>
	<SectionPattern bottom="base-pattern" />

	<FaqSection
		tone="light"
		eyebrow="Respondemos tus dudas"
		title="Preguntas "
		underline="frecuentes"
		items={faqs}
		padding="large"
	/>

	<CtaSection
		variant="image"
		disfuminar='bottom'
		bgImage={ctaBg}
		title="¿Listo para que tu hijo viva "
		underline="esta experiencia"
		titleAfter="?"
		buttons={[
			{ label: 'Inscribir ahora', href: '/coming-soon', variant: 'white' },
			{ label: 'Tengo preguntas', href: '/contacto', variant: 'link' },
		]}
	>
		<SectionPattern bottom="slow-curve" additionalClasses={['text-white']} />
	</CtaSection>

</Layout>