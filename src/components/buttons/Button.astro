---
import UnderlineStroke from '../titles/UnderlineStroke.astro';

export type ButtonVariant = 'primary' | 'secondary' | 'tertiary' | 'white' | 'foreground' | 'outline' | 'ghost' | 'link';
export type ButtonWeight = 'normal' | 'medium' | 'semibold' | 'bold';
export type ButtonRadius = 'full' | 'lg' | 'none';
export type ButtonSize = 'sm' | 'default' | 'lg' | 'xl';

export interface Props {
	/** Texto del botón */
	label: string;
	/** Si existe renderiza un <a>, si no un <button> */
	href?: string;
	/** Solo para <a> */
	target?: string;
	rel?: string;
	/** Solo para <button> */
	type?: 'button' | 'submit' | 'reset';
	/** Estilo/estructura base. Define colores por defecto que puedes sobreescribir */
	variant?: ButtonVariant;
	/** Peso tipográfico (default: semibold; medium en link) */
	weight?: ButtonWeight;
	size?: ButtonSize;
	radius?: ButtonRadius;
	/** Clases Tailwind del color de texto (ej. "text-white"). Sobreescribe el preset del variant */
	textColor?: string;
	/** Clases Tailwind del color de fondo (ej. "bg-primary hover:bg-primary/90"). Sobreescribe el preset */
	bgColor?: string;
	/** Clases Tailwind del color del borde (ej. "border-primary/40 hover:border-primary"). Sobreescribe el preset */
	borderColor?: string;
	/** Clases Tailwind del trazo del subrayado (variant="link"); por defecto usa textColor */
	underlineColor?: string;
	/** Para variant="link": subraya el texto con UnderlineStroke */
	underline?: boolean;
	class?: string;
	disabled?: boolean;
	ariaLabel?: string;
	/** data-lead-dialog-trigger */
	dataDialogTrigger?: string;
	/** Atributos extra (data-*, aria-*, etc.) */
	attrs?: Record<string, string | boolean | number | null | undefined>;
}

export type ButtonProps = Props;

const {
	label,
	href,
	target,
	rel,
	type = 'button',
	variant = 'primary',
	weight,
	size = 'default',
	radius = 'full',
	textColor,
	bgColor,
	borderColor,
	underlineColor,
	underline = false,
	class: extraClass = '',
	disabled = false,
	ariaLabel,
	dataDialogTrigger,
	attrs,
} = Astro.props;

interface VariantPreset {
	base: string;
	bg: string;
	text: string;
	border: string;
}

const variantPresets: Record<ButtonVariant, VariantPreset> = {
	primary:   { base: '',                     bg: 'bg-primary hover:bg-primary/90',                  text: 'text-primary-foreground', border: '' },
	secondary: { base: '',                     bg: 'bg-secondary hover:bg-secondary/90',              text: 'text-secondary-foreground', border: '' },
	tertiary:  { base: '',                     bg: 'bg-tertiary hover:bg-tertiary/90',                text: 'text-neutral-900',       border: '' },
	white:     { base: '',                     bg: 'bg-white hover:bg-neutral-100',                  text: 'text-neutral-900',       border: '' },
	foreground:{ base: '',                     bg: 'bg-primary-foreground hover:bg-primary-foreground/90', text: 'text-primary',     border: '' },
	outline:   { base: '',                     bg: 'hover:bg-primary/5',                             text: 'text-primary',           border: 'border border-primary/40 hover:border-primary' },
	ghost:     { base: 'hover:opacity-70',     bg: '',                                               text: 'text-primary',           border: '' },
	link:      { base: 'transition-opacity hover:opacity-70', bg: '',                                text: 'text-primary',           border: '' },
};

const sizes: Record<ButtonSize, string> = {
	sm: 'px-5 py-2.5 text-sm',
	default: 'px-8 py-3.5 text-base',
	lg: 'px-10 py-4 text-lg',
	xl: 'px-12 py-5 text-xl',
};

const linkSizes: Record<ButtonSize, string> = {
	sm: 'text-sm',
	default: 'text-base',
	lg: 'text-lg',
	xl: 'text-xl',
};

const radii: Record<ButtonRadius, string> = {
	full: 'rounded-full',
	lg: 'rounded-lg',
	none: '',
};

const weights: Record<ButtonWeight, string> = {
	normal: 'font-normal',
	medium: 'font-medium',
	semibold: 'font-semibold',
	bold: 'font-bold',
};

const preset = variantPresets[variant] ?? variantPresets.primary;
const resolvedText = textColor ?? preset.text;
const resolvedBg   = bgColor   ?? preset.bg;
const resolvedBorder = borderColor
	? `${preset.border.includes('border') ? '' : 'border '}${borderColor}`
	: preset.border;

/** Los botones con fondo de color suben una talla (sm → default → lg → xl) */
const filledVariants = new Set<ButtonVariant>(['primary', 'secondary', 'tertiary', 'white', 'foreground']);
const hasFilledBg = filledVariants.has(variant) || Boolean(bgColor);
const sizeUp: Record<ButtonSize, ButtonSize> = { sm: 'default', default: 'lg', lg: 'xl', xl: 'xl' };
const effectiveSize = hasFilledBg ? sizeUp[size] : size;

const weightClass = weight ? weights[weight] : variant === 'link' ? weights.medium : weights.semibold;
const hasTextSize = /text-(xs|sm|base|lg|xl|2xl)/.test(extraClass);
const linkSizeClass = hasTextSize ? '' : linkSizes[size];

const focusClass = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';

let cls: string;
if (variant === 'link') {
	cls = `${focusClass} inline-flex items-center justify-center ${preset.base} ${linkSizeClass} ${weightClass} ${resolvedText}`;
} else {
	cls = `${focusClass} inline-flex items-center justify-center transition-colors duration-200 ease-out ${sizes[effectiveSize]} ${radii[radius]} ${weightClass} ${resolvedBorder} ${resolvedBg} ${resolvedText} ${preset.base}`;
}

if (disabled) cls += ' cursor-not-allowed opacity-60';
cls = `${cls} ${extraClass} uppercase`.trim();

const common = {
	...attrs,
	class: cls,
	'aria-label': ariaLabel,
	'data-lead-dialog-trigger': dataDialogTrigger,
};
---

{
	href && (
		<a href={href} target={target} rel={rel} {...common}>
			{variant === 'link' && underline ? (
				<UnderlineStroke color={underlineColor ?? resolvedText}>{label}</UnderlineStroke>
			) : (
				label
			)}
		</a>
	)
}
{
	!href && (
		<button type={type} disabled={disabled} {...common}>
			{variant === 'link' && underline ? (
				<UnderlineStroke color={underlineColor ?? resolvedText}>{label}</UnderlineStroke>
			) : (
				label
			)}
		</button>
	)
}