---
import Button from '../buttons/Button.astro';
import type { ButtonProps, ButtonVariant } from '../buttons/Button.astro';

export interface Cta {
	label: string;
	href: string;
	variant?: ButtonVariant;
	size?: ButtonProps['size'];
	weight?: ButtonProps['weight'];
	radius?: ButtonProps['radius'];
	/** Clase de color del texto (ej. "text-white") */
	textColor?: string;
	/** Clase de color del fondo (ej. "bg-primary hover:bg-primary/90") */
	bgColor?: string;
	/** Clase de color del borde (ej. "border-white/40 hover:border-white") */
	borderColor?: string;
	underline?: boolean;
	underlineColor?: string;
	target?: string;
	rel?: string;
	attrs?: ButtonProps['attrs'];
}

export interface Props {
	/** Lista de botones de llamada a la acción */
	ctas: Cta[];
	/** Clase del contenedor flex */
	class?: string;
	/** Tamaño de los botones */
	size?: ButtonProps['size'];
}

const { ctas, class: containerClass = '', size = 'default' } = Astro.props;
---

<div class:list={['flex flex-col items-center gap-4', containerClass]}>
	{ctas.map((cta) => (
		<Button
			label={cta.label}
			href={cta.href}
			variant={cta.variant ?? 'white'}
			size={size ?? cta.size}
			weight={cta.weight}
			radius={cta.radius}
			textColor={cta.textColor}
			bgColor={cta.bgColor}
			borderColor={cta.borderColor}
			underline={cta.underline}
			underlineColor={cta.underlineColor}
			target={cta.target}
			rel={cta.rel}
			attrs={cta.attrs}
		/>
	))}
</div>