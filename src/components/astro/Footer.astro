---
import { WHATSAPP_URL, EMAIL_URL } from "../../lib/social";
import logoSrc from "../../assets/cappi-extremo-logo.png?url";
import Button from "../buttons/Button.astro";

const year = new Date().getFullYear();
---

<footer class="bg-white">
	<div
		class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-8 gap-y-4 px-4 py-10 sm:px-6 md:min-h-40 md:grid md:grid-cols-5 md:max-w-max md:text-center lg:px-8"
	>
		<a
			href={WHATSAPP_URL}
			target="_blank"
			rel="noopener noreferrer"
			class="text-lg font-medium uppercase text-neutral-700 transition-colors hover:text-primary"
		>
			WhatsApp
		</a>

		<a
			href={EMAIL_URL}
			class="text-lg font-medium uppercase text-neutral-700 transition-colors hover:text-primary"
		>
			Mail
		</a>

		<a
			href="/coming-soon"
			class=" text-lg font-medium uppercase text-neutral-700 transition-colors hover:text-primary"
		>
			Inscribirse
		</a>

		<a
			href="/coming-soon"
			class="text-lg font-medium uppercase text-neutral-700 transition-colors hover:text-primary"
		>
			Login
		</a>
		<Button type="button" href="/quiero-ser-staff" label="¡QUIERO SER STAFF!" variant="primary" />
	</div>

	<div class="border-t border-neutral-200">
		<div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-8 gap-y-2 px-4 py-6 text-sm text-neutral-600 sm:px-6 lg:px-8">
			<a href="/" class="transition-colors hover:text-primary">Inicio</a>
			<a href="/quienes-somos" class="transition-colors hover:text-primary">Quiénes somos</a>
			<a href="/plan-vacacional" class="transition-colors hover:text-primary">Planes vacacionales</a>
			<a href="/tienda" class="transition-colors hover:text-primary">Tienda</a>
			<a href="/celebra-con-cappi" class="transition-colors hover:text-primary">Celebra con Cappi</a>
			<a href="/experiencias-escolares" class="transition-colors hover:text-primary">Experiencias escolares</a>
			<a href="/eventos-corporativos" class="transition-colors hover:text-primary">Eventos corporativos</a>
			<a href="/nuestro-staff" class="transition-colors hover:text-primary">Nuestro Staff</a>
			<a href="/familias" class="transition-colors hover:text-primary">Familias</a>
			<a href="/contacto" class="transition-colors hover:text-primary">Contacto</a>
			<a href="/privacidad" class="transition-colors hover:text-primary">Políticas de privacidad</a>
			<a href="/terminos" class="transition-colors hover:text-primary">Términos y condiciones</a>
		</div>
		<p class="text-center text-neutral-600 pb-6">© {year} Cappi Extremo. Todos los derechos reservados.</p>
	</div>
</footer>
