---
import MobileMenu from "../react/MobileMenu";
import DesktopMegaMenu from "./DesktopMegaMenu.astro";
import Button from "../buttons/Button.astro";
import { navigation } from "../../data/navigation";

import logoSrc from "../../assets/cappi-extremo-logo.png?url";

const ctaHref = "/coming-soon";
const { pathname } = Astro.url;
---

<header class="sticky top-0 z-40 bg-white shadow-sm">
	<div class="relative overflow-visible">
		<nav
			aria-label="Navegación principal"
			class="z-20 mx-auto grid h-18 max-w-7xl grid-cols-2 items-center px-4 sm:px-6 md:h-24 lg:grid-cols-[1fr_auto_1fr] lg:px-8"
		>
			<a href="/" class="justify-self-start focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
				<img src={logoSrc} alt="Cappi Extremo" class="h-12 w-auto md:h-20" />
			</a>

			<DesktopMegaMenu navigation={navigation} currentPath={pathname} />

			<div class="flex items-center justify-self-end gap-3">
				<MobileMenu client:load navigation={navigation} ctaHref={ctaHref} currentPath={pathname} />
				<Button label="Inscribir ahora" href={ctaHref} variant="primary" size="sm" class="hidden lg:inline-flex" />
			</div>
		</nav>
	</div>
</header>
