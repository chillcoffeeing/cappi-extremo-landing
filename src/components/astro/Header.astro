---
import MobileMenu from "../react/MobileMenu";

import logoSrc from "../../assets/cappi-extremo-logo.png?url";

const navLinks = [
	{ href: "/", label: "Inicio" },
	{ href: "/quienes-somos", label: "Quiénes somos" },
	{ href: "/planes-vacacionales", label: "Planes vacacionales" },
	{ href: "/tienda", label: "Tienda" },
	{ href: "/programas-especiales", label: "Programas especiales" },
	{ href: "/familias", label: "Familias" },
	{ href: "/contacto", label: "Contacto" },
];

const primaryLinks = navLinks.slice(0, 4);
const moreLinks = navLinks.slice(4);

const ctaHref = "/coming-soon";
const { pathname } = Astro.url;

const isActive = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));

const moreActive = moreLinks.some((link) => isActive(link.href));

---

<header class="sticky top-0 z-40 bg-white shadow-sm">

	<nav
		class="z-10 relative mx-auto grid h-18 max-w-7xl grid-cols-2 items-center px-4 sm:px-6 md:h-24 md:grid-cols-[1fr_auto_1fr] lg:px-8"
	>
		<a href="/" class="justify-self-start">
			<img src={logoSrc} alt="Cappi Extremo" class="h-12 w-auto md:h-20" />
		</a>

		<ul class="hidden items-center justify-self-center gap-2 md:flex">
			{
				primaryLinks.map((link) => (
					<li>
						<a
							href={link.href}
							aria-current={isActive(link.href) ? "page" : undefined}
							class:list={[
								"rounded-full px-4 py-2 uppercase transition-colors",
								isActive(link.href)
									? "bg-primary/10 text-sm font-semibold text-primary"
									: "text-sm font-medium text-neutral-700 hover:text-primary",
							]}
						>
							{link.label}
						</a>
					</li>
				))
			}

			<li class="relative" data-dropdown>
				<button
					type="button"
					data-dropdown-trigger
					aria-haspopup="true"
					aria-expanded="false"
					class:list={[
						"flex items-center gap-1 rounded-full px-4 py-2 uppercase transition-colors",
						moreActive
							? "bg-primary/10 text-sm font-semibold text-primary"
							: "text-sm font-medium text-neutral-700 hover:text-primary",
					]}
				>
					Más
					<svg class="size-3.5 transition-transform data-[open=true]:rotate-180" data-open="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="m6 9 6 6 6-6" />
					</svg>
				</button>

				<div
					data-dropdown-menu
					class="invisible absolute left-1/2 top-full z-20 mt-2 min-w-52 -translate-x-1/2 scale-95 rounded-2xl border border-neutral-200 bg-white p-2 opacity-0 shadow-lg transition-all duration-150 data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:scale-100 data-[open=true]:opacity-100"
				>
					{
						moreLinks.map((link) => (
							<a
								href={link.href}
								aria-current={isActive(link.href) ? "page" : undefined}
								class:list={[
									"block rounded-xl px-4 py-2.5 text-sm uppercase transition-colors",
									isActive(link.href)
										? "bg-primary/10 font-semibold text-primary"
										: "text-neutral-700 hover:bg-neutral-50 hover:text-primary",
								]}
							>
								{link.label}
							</a>
						))
					}
				</div>
			</li>
		</ul>

		<script>
			document.querySelectorAll("[data-dropdown]").forEach((dropdown) => {
				const trigger = dropdown.querySelector("[data-dropdown-trigger]");
				const menu = dropdown.querySelector("[data-dropdown-menu]");
				const chevron = trigger!.querySelector("[data-open]");

				if (!trigger || !menu) return;

				const setOpen = (open: boolean) => {
					trigger.setAttribute("aria-expanded", String(open));
					menu.setAttribute("data-open", String(open));
					chevron?.setAttribute("data-open", String(open));
				};

				trigger.addEventListener("click", (event) => {
					event.stopPropagation();
					setOpen(menu.getAttribute("data-open") !== "true");
				});

				dropdown.addEventListener("mouseenter", () => setOpen(true));
				dropdown.addEventListener("mouseleave", () => setOpen(false));

				document.addEventListener("click", (event) => {
					if (!dropdown.contains(event.target as Node)) setOpen(false);
				});
			});
		</script>

		<div class="flex items-center justify-self-end gap-3">
			<MobileMenu client:load links={navLinks} ctaHref={ctaHref} currentPath={pathname} />
			<a
				href={ctaHref}
				class="hidden rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 md:inline-flex"
			>
				Inscribir ahora
			</a>
		</div>
	</nav>
	
</header>
