---
interface Props {
	color?: 'primary' | 'secondary';
	side?: 'left' | 'right';
	position?: 'top' | 'center' | 'bottom';
	class?: string;
	size?: 'xs' | 'small' | 'medium' | 'large' | 'xl';
}

const {
	color = 'secondary',
	side = 'right',
	position = 'center',
	class: className,
	size = 'medium',
} = Astro.props;

const bg = color === 'primary' ? 'bg-primary' : 'bg-secondary';

const vPos =
	position === 'top'
		? 'top-10'
		: position === 'bottom'
			? 'bottom-10'
			: 'top-1/2 -translate-y-1/2';

const sidePos = side === 'left' ? 'left-0 -translate-x-1/2' : 'right-0 translate-x-1/2';

const sizes = {
	xs: 'size-[70px]',
	small: 'size-[100px]',
	medium: 'size-[150px]',
	large: 'size-[200px]',
	xl: 'size-[300px]',
};
const circleSize = sizes[size] ?? sizes.medium;
---

<div
	aria-hidden="true"
	class:list={['pointer-events-none absolute -z-10', circleSize, 'rounded-full', bg, sidePos, vPos, className]}
/>
