---
import type { NavigationGroup, NavigationItem, NavigationLink } from "../../data/navigation";
import { Icon } from "astro-icon/components";

interface Props {
	navigation: NavigationItem[];
	currentPath: string;
}

const { navigation, currentPath } = Astro.props;

const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
const isGroup = (item: NavigationItem): item is NavigationGroup => item.kind === "group";
const groupIsActive = (group: NavigationGroup) => group.sections.some((section) => section.items.some((item) => isActive(item.href)));

const linkClasses = (link: NavigationLink) => [
	"block px-3 py-2 rounded-full px-4 text-xs font-semibold uppercase tracking-wide transition-colors",
	"focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
	isActive(link.href)
		? "bg-primary/10 text-primary rounded-full"
		: "text-neutral-700 hover:bg-neutral-100 hover:text-primary",
];
---

<div data-mega-menu class="hidden h-full lg:flex">
	<ul class="flex h-full items-center justify-center w-full gap-1" aria-label="Secciones principales">
		{
			navigation.map((item) =>
				isGroup(item) ? (
					<li
						data-mega-group={item.id}
						class="h-full"
						data-route-active={groupIsActive(item) ? "true" : "false"}
					>
						<button
							id={`mega-trigger-${item.id}`}
							data-mega-trigger
							data-group-id={item.id}
							type="button"
							aria-haspopup="true"
							aria-expanded="false"
							aria-controls={`mega-panel-${item.id}`}
							data-active={groupIsActive(item) ? "true" : "false"}
							class:list={[
								"flex h-full items-center gap-1 px-4 py-2 text-sm font-medium uppercase transition-colors",
								"focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
								" data-[active=true]:text-primary",
								"text-neutral-700 hover:text-primary",
							]}
						>
							{item.label}
							<Icon name="lucide:chevron-down" class="size-4 shrink-0" aria-hidden="true" />
						</button>

						<div
							id={`mega-panel-${item.id}`}
							data-mega-panel
							data-state="closed"
							role="region"
							aria-labelledby={`mega-trigger-${item.id}`}
							aria-hidden="true"
							inert
							class="pointer-events-none invisible absolute inset-x-0 top-full z-10 -translate-y-1 border-t border-neutral-100 bg-white opacity-0 shadow-lg transition-[opacity,transform,visibility] duration-150 ease-out motion-reduce:transition-none data-[state=open]:pointer-events-auto data-[state=open]:visible data-[state=open]:translate-y-0 data-[state=open]:opacity-100"
						>
							<div class="container max-h-[min(30rem,calc(100dvh-6rem))] gap-x-20 gap-y-6 overflow-y-auto py-7 flex items-start justify-center">
								{item.sections.map((section) => (
									<section aria-labelledby={`mega-section-${section.id}`}>
										<h3
											id={`mega-section-${section.id}`}
											class="text-xs font-bold px-4 tracking-[0.16em] text-primary"
										>
											{section.label}
										</h3>
										<ul class="mt-3 space-y-1" aria-labelledby={`mega-section-${section.id}`}>
											{section.items.map((link) => (
												<li>
													<a
														href={link.href}
														aria-current={isActive(link.href) ? "page" : undefined}
														class:list={linkClasses(link)}
													>
														{link.label}
													</a>
												</li>
											))}
										</ul>
									</section>
								))}
							</div>
						</div>
					</li>
				) : (
					<li>
						<a
							href={item.href}
							aria-current={isActive(item.href) ? "page" : undefined}
							class:list={[
								"block px-4 py-2 text-sm font-medium uppercase transition-colors",
								"focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
								isActive(item.href)
									? "bg-primary/10 font-semibold text-primary rounded-full"
									: "text-neutral-700 hover:text-primary",
							]}
						>
							{item.label}
						</a>
					</li>
				),
			)
		}
	</ul>

	<script>
		const root = document.querySelector<HTMLElement>("[data-mega-menu]");

		if (root) {
			const groups = Array.from(root.querySelectorAll<HTMLElement>("[data-mega-group]"));
			let closeTimer: number | undefined;
			let openId: string | null = null;

			const clearCloseTimer = () => {
				if (closeTimer !== undefined) window.clearTimeout(closeTimer);
				closeTimer = undefined;
			};

			const getParts = (group: HTMLElement) => ({
				trigger: group.querySelector<HTMLButtonElement>("[data-mega-trigger]"),
				panel: group.querySelector<HTMLElement>("[data-mega-panel]"),
			});

			const setGroupState = (group: HTMLElement, isOpen: boolean) => {
				const { trigger, panel } = getParts(group);
				if (!trigger || !panel) return;

				const routeActive = group.dataset.routeActive === "true";
				trigger.setAttribute("aria-expanded", String(isOpen));
				trigger.setAttribute("data-active", String(isOpen || routeActive));
				panel.setAttribute("aria-hidden", String(!isOpen));
				panel.setAttribute("data-state", isOpen ? "open" : "closed");
				panel.toggleAttribute("inert", !isOpen);
			};

			const closeAll = () => {
				clearCloseTimer();
				openId = null;
				groups.forEach((group) => setGroupState(group, false));
			};

			const openGroup = (id: string) => {
				clearCloseTimer();
				openId = id;
				groups.forEach((group) => setGroupState(group, group.dataset.megaGroup === id));
			};

			const scheduleClose = () => {
				clearCloseTimer();
				closeTimer = window.setTimeout(closeAll, 120);
			};

			groups.forEach((group) => {
				const trigger = group.querySelector<HTMLButtonElement>("[data-mega-trigger]");
				if (!trigger) return;

				group.addEventListener("pointerenter", () => openGroup(group.dataset.megaGroup ?? ""));
				trigger.addEventListener("keydown", (event) => {
					if (event.key === "Enter" || event.key === " ") {
						event.preventDefault();
						openGroup(group.dataset.megaGroup ?? "");
					}

					if (event.key === "ArrowDown") {
						event.preventDefault();
						openGroup(group.dataset.megaGroup ?? "");
						group.querySelector<HTMLAnchorElement>("[data-mega-panel] a")?.focus();
					}
				});
			});

			root.addEventListener("pointerenter", clearCloseTimer);
			root.addEventListener("pointerleave", scheduleClose);
			root.addEventListener("focusin", (event) => {
				const target = event.target as HTMLElement;
				const group = target.closest<HTMLElement>("[data-mega-group]");
				if (group?.dataset.megaGroup) openGroup(group.dataset.megaGroup);
			});
			root.addEventListener("focusout", (event) => {
				const nextTarget = event.relatedTarget as Node | null;
				if (!nextTarget || !root.contains(nextTarget)) scheduleClose();
			});
			root.addEventListener("keydown", (event) => {
				if (event.key !== "Escape") return;
				const activeGroup = groups.find((group) => group.dataset.megaGroup === openId);
				if (!activeGroup) return;
				event.preventDefault();
				closeAll();
				activeGroup.querySelector<HTMLButtonElement>("[data-mega-trigger]")?.focus();
			});
			document.addEventListener("pointerdown", (event) => {
				if (!root.contains(event.target as Node)) closeAll();
			});
			window.addEventListener("resize", closeAll, { passive: true });
		}
	</script>
</div>
