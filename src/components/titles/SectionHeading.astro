---
import UnderlineStroke from './UnderlineStroke.astro';

export interface Props {
	/** Texto corto en mayúsculas sobre el título */
	eyebrow?: string;
	/** Color de eyebrow */
	eyebrowColor?: 'primary' | 'secondary' | 'neutral' | 'tertiary';
	/** Fragmento del eyebrow resaltado en primary */
	eyebrowHighlight?: string;
	/** Título de la sección */
	title: string;
	/** Palabras subrayadas con UnderlineStroke */
	underline?: string;
	/** Color del trazo y acentos del heading */
	color?: 'primary' | 'secondary' | 'neutral' | 'tertiary';
	/** Evita que el subrayado se parta en varias líneas */
	underlineNowrap?: boolean;
	/** Párrafo introductorio centrado */
	intro?: string;
	/** Clases extra para el <p> intro */
	introClass?: string;
	/** Clases extra para el <h2> */
	titleClass?: string;
}

const {
	eyebrow,
	eyebrowColor,
	eyebrowHighlight,
	title,
	underline,
	color = 'primary',
	underlineNowrap = true,
	intro,
	introClass = '',
	titleClass = '',
} = Astro.props;

const colorMap = {
	primary: { accent: 'text-primary', underline: 'text-primary', intro: 'text-neutral-600' },
	secondary: { accent: 'text-secondary', underline: 'text-secondary', intro: 'text-neutral-600' },
	neutral: { accent: 'text-neutral-600', underline: 'text-neutral-400', intro: 'text-neutral-600' },
	tertiary: { accent: 'text-primary', underline: 'text-primary', intro: 'text-neutral-600' },
} as const;

const palette = colorMap[color];
const eyebrowClass = eyebrowColor ? `text-${eyebrowColor}` : palette.accent;
const underlineColor = palette.underline;
const introColor = palette.intro;

const titleBase = 'mt-3 text-center font-semibold uppercase text-neutral-900 md:leading-tight';
---

{
	eyebrow && (
		<p data-motion="fade-up" class:list={['text-center font-semibold uppercase tracking-widest', eyebrowClass]}>
			{eyebrow}
			{eyebrowHighlight && <span>{eyebrowHighlight}</span>}
		</p>
	)
}
<h2 data-motion="fade-up" class:list={[titleBase, titleClass]}>
	{title}
	{underline && <UnderlineStroke color={underlineColor} nowrap={underlineNowrap}>{underline}</UnderlineStroke>}
</h2>
{intro && (
	<p
		data-motion="fade-up"
		class:list={['mx-auto mt-4 max-w-[700px] text-center leading-relaxed', introColor, introClass]}
	>
		{intro}
	</p>
)}
