---
import SectionHeading from '../../titles/SectionHeading.astro';
import Button from '../../buttons/Button.astro';

export interface Step {
	number: string;
	title: string;
	description: string;
}

export interface Cta {
	label: string;
	href: string;
	variant?: 'white' | 'link';
}

export interface Props {
	eyebrow: string;
	title?: string;
	underline?: string;
	underlineColor?: string;
	steps: Step[];
	/** Columnas en desktop (3 o 4) */
	columns?: 3 | 4;
	/** CTA bajo los pasos */
	cta?: Cta;
}

const {
	eyebrow,
	title = '',
	underline,
	underlineColor = 'text-primary',
	steps,
	columns = 4,
	cta,
} = Astro.props;

const gridClass =
	columns === 4
		? 'mx-auto mt-14 grid max-w-4xl grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4'
		: 'mx-auto mt-14 grid max-w-3xl grid-cols-1 gap-8 sm:grid-cols-3';
---

<section class="relative z-10 isolate bg-sections py-16 md:py-24">
	<div class="container">
		<SectionHeading
			eyebrow={eyebrow}
			title={title}
			underline={underline}
			underlineColor={underlineColor}
			tone="dark"
		/>

		<div class={gridClass}>
			{steps.map((step) => (
				<div data-motion="fade-up" class="flex flex-col items-center text-center">
					<div class="flex size-14 items-center justify-center rounded-full bg-primary text-xl font-bold text-primary-foreground">
						{step.number}
					</div>
					<h3 class="mt-4 font-semibold text-neutral-900">{step.title}</h3>
					<p class="mt-2 text-neutral-600">{step.description}</p>
				</div>
			))}
		</div>

		{cta && (
			<div data-motion="fade-up" class="mt-12 flex flex-col items-center gap-4">
				<Button
					label={cta.label}
					href={cta.href}
					variant={cta.variant ?? 'white'}
					linkColor={cta.variant === 'link' ? 'text-primary' : undefined}
				/>
			</div>
		)}
	</div>
</section>