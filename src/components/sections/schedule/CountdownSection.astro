---
import Countdown from '../../date-components/Countdown.astro';
import CtaList from '../../cta/CtaList.astro';
import type { Cta } from '../../cta/CtaList.astro';

export interface Props {
	/** Título (h2) de la banda */
	title: string;
	/** Fecha objetivo del countdown */
	target: string;
	/** id del countdown (default pv-countdown) */
	countdownId?: string;
	/** Botones CTA bajo el countdown */
	ctas?: Cta[];
}

const { title, target, countdownId = 'pv-countdown', ctas = [] } = Astro.props;
---

<section class="relative z-10 isolate overflow-hidden bg-sections">
	<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-20 lg:px-8">
		<h2
			id={`${countdownId}-title`}
			data-motion="fade-up"
			class="text-center font-semibold uppercase tracking-tight text-neutral-900 md:leading-tight"
		>
			{title}
		</h2>

		<Countdown id={countdownId} target={target} size="standard" />

		{ctas.length > 0 && <CtaList ctas={ctas.map((cta) => ({ ...cta, variant: cta.variant === 'link' ? 'link' : 'primary' }))} size="sm" class="mt-10" />}
	</div>
</section>