---
import SectionHeading from '../../titles/SectionHeading.astro';
import { WHATSAPP_URL, EMAIL_URL } from '../../../lib/social';

export interface Channel {
	title: string;
	subtitle: string;
	href: string;
	target?: string;
	icon: 'whatsapp' | 'mail';
}

export interface ScheduleEntry {
	range: string;
	hours: string;
	dimmed?: boolean;
}

export interface Props {
	formTitle?: string;
	formIntro?: string;
	channels?: Channel[];
	schedule: ScheduleEntry[];
}

const DEFAULT_CHANNELS: Channel[] = [
	{
		title: 'WhatsApp',
		subtitle: 'Respuesta inmediata',
		href: WHATSAPP_URL,
		target: '_blank',
		icon: 'whatsapp',
	},
	{
		title: 'Correo electrónico',
		subtitle: 'Te respondemos en 24 horas',
		href: EMAIL_URL,
		icon: 'mail',
	},
];

const {
	formTitle = 'Formulario de ',
	formIntro = 'Cuéntanos en qué te podemos ayudar y te responderemos a la brevedad.',
	channels = DEFAULT_CHANNELS,
	schedule,
} = Astro.props;

const inputClass =
	'mt-1.5 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary';
---

<section class="py-16 md:py-24">
	<div class="container">
		<div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
			<div>
				<SectionHeading eyebrow="Escríbenos" title={formTitle} underline="contacto" />

				<p data-motion="fade-up" class="mt-4 leading-relaxed text-neutral-600">
					{formIntro}
				</p>

				<form data-motion="fade-up" class="mt-8 space-y-5" action="#" method="POST">
					<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
						<div>
							<label for="name" class="block text-sm font-medium text-neutral-700">Nombre</label>
							<input type="text" id="name" name="name" required class={inputClass} placeholder="Tu nombre" />
						</div>
						<div>
							<label for="email" class="block text-sm font-medium text-neutral-700">Correo</label>
							<input type="email" id="email" name="email" required class={inputClass} placeholder="tu@correo.com" />
						</div>
					</div>
					<div>
						<label for="subject" class="block text-sm font-medium text-neutral-700">Asunto</label>
						<select id="subject" name="subject" class={inputClass}>
							<option>Inscripción plan vacacional</option>
							<option>Cotización fiesta o evento</option>
							<option>Otra pregunta</option>
						</select>
					</div>
					<div>
						<label for="message" class="block text-sm font-medium text-neutral-700">Mensaje</label>
						<textarea id="message" name="message" rows="5" required class={inputClass} placeholder="Cuéntanos en qué te podemos ayudar..."></textarea>
					</div>
					<button data-motion="fade-up" type="submit" class="inline-flex items-center justify-center rounded-full bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
						Enviar mensaje
					</button>
				</form>
			</div>

			<div class="flex flex-col gap-8 lg:pl-12">
				<div data-motion="fade-up">
					<h3 class="font-semibold text-neutral-900">Contacto directo</h3>
					<p class="mt-3 leading-relaxed text-neutral-600">
						Si prefieres hablar con nosotros directamente, usa cualquiera de estos canales.
					</p>
				</div>

				<div class="space-y-4">
					{channels.map((channel) => (
						<a
							href={channel.href}
							target={channel.target}
							rel={channel.target ? 'noopener noreferrer' : undefined}
							data-motion="fade-up"
							class="flex items-center gap-4 rounded-2xl border border-neutral-200 p-6 transition-colors hover:border-primary/50 hover:bg-primary/5"
						>
							<div class={`flex size-14 items-center justify-center rounded-full ${channel.icon === 'whatsapp' ? 'bg-primary/10' : 'bg-secondary/10'}`}>
								{channel.icon === 'whatsapp' ? (
									<svg class="size-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" /><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1zm0 0a5 5 0 0 0 5 5m0 0a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1h1z" />
									</svg>
								) : (
									<svg class="size-7 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2Z" /><path d="m22 6-10 7L2 6" />
									</svg>
								)}
							</div>
							<div>
								<p class="font-semibold text-neutral-900">{channel.title}</p>
								<p class="text-neutral-500">{channel.subtitle}</p>
							</div>
						</a>
					))}
				</div>

				<div data-motion="fade-up" class="rounded-2xl bg-secondary/10 p-6">
					<h4 class="font-semibold text-neutral-900">Horario de atención</h4>
					<ul class="mt-4 space-y-3 text-base text-neutral-600">
						{schedule.map((entry) => (
							<li class="flex justify-between">
								<span>{entry.range}</span>
								<span class={`font-medium ${entry.dimmed ? 'text-neutral-500' : 'text-neutral-900'}`}>{entry.hours}</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>