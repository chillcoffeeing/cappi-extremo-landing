---
import SectionHeading from '../../titles/SectionHeading.astro';
import Button from '../../buttons/Button.astro';
import ConsentCheckbox from '../../forms/ConsentCheckbox.astro';
import TurnstileField from '../../forms/TurnstileField.astro';
import { Icon } from 'astro-icon/components';
import { WHATSAPP_URL, EMAIL_URL } from '../../../lib/social';

export interface Channel {
	title: string;
	subtitle: string;
	href: string;
	target?: string;
	icon: 'whatsapp' | 'mail';
}

export interface ScheduleEntry {
	range: string;
	hours: string;
	dimmed?: boolean;
}

export interface Props {
	formTitle?: string;
	formIntro?: string;
	channels?: Channel[];
	schedule: ScheduleEntry[];
}

const DEFAULT_CHANNELS: Channel[] = [
	{
		title: 'WhatsApp',
		subtitle: 'Respuesta inmediata',
		href: WHATSAPP_URL,
		target: '_blank',
		icon: 'whatsapp',
	},
	{
		title: 'Correo electrónico',
		subtitle: 'Te respondemos en 24 horas',
		href: EMAIL_URL,
		icon: 'mail',
	},
];

const {
	formTitle = 'Formulario de ',
	formIntro = 'Cuéntanos en qué te podemos ayudar y te responderemos a la brevedad.',
	channels = DEFAULT_CHANNELS,
	schedule,
} = Astro.props;

const inputClass =
	'mt-1.5 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary';
---

<section class="py-16 md:py-24">
	<div class="container">
		<div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
			<div>
				<SectionHeading eyebrow="Escríbenos" title={formTitle} underline="contacto" />

				<p data-motion="fade-up" class="mt-4 leading-relaxed text-neutral-600">
					{formIntro}
				</p>

				<form data-motion="fade-up" data-contact-form class="mt-8 space-y-5" action="#" method="POST">
					<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
						<div>
							<label for="name" class="block text-sm font-medium text-neutral-700">Nombre</label>
							<input type="text" id="name" name="name" required class={inputClass} placeholder="Tu nombre" />
						</div>
						<div>
							<label for="email" class="block text-sm font-medium text-neutral-700">Correo</label>
							<input type="email" id="email" name="email" required class={inputClass} placeholder="tu@correo.com" />
						</div>
					</div>
					<div>
						<label for="subject" class="block text-sm font-medium text-neutral-700">Asunto</label>
						<select id="subject" name="subject" class={inputClass}>
							<option>Inscripción plan vacacional</option>
							<option>Cotización fiesta o evento</option>
							<option value="Quiero ser staff">Quiero ser staff</option>
							<option>Otra pregunta</option>
						</select>
					</div>
					<div>
						<label for="message" class="block text-sm font-medium text-neutral-700">Mensaje</label>
						<textarea id="message" name="message" rows="5" required class={inputClass} placeholder="Cuéntanos en qué te podemos ayudar..."></textarea>
					</div>
				
					<ConsentCheckbox />
					<TurnstileField id="contact-turnstile" />
				
					<p data-contact-status class="min-h-6 text-sm text-red-600" aria-live="polite" role="alert"></p>
					<Button type="submit" variant="primary" label="Enviar mensaje" attrs={{ 'data-motion': 'fade-up' }} />
				</form>
			</div>

			<div class="flex flex-col gap-8 lg:pl-12">
				<div data-motion="fade-up">
					<h3 class="font-semibold text-neutral-900">Contacto directo</h3>
					<p class="mt-3 leading-relaxed text-neutral-600">
						Si prefieres hablar con nosotros directamente, usa cualquiera de estos canales.
					</p>
				</div>

				<div class="space-y-4">
					{channels.map((channel) => (
						<a
							href={channel.href}
							target={channel.target}
							rel={channel.target ? 'noopener noreferrer' : undefined}
							data-motion="fade-up"
							class="flex items-center gap-4 rounded-2xl border border-neutral-200 p-6 transition-colors hover:border-secondary/50 hover:bg-secondary/5"
						>
							<div class="flex size-14 items-center justify-center rounded-full bg-secondary/10">
								{channel.icon === 'whatsapp' ? (
									<Icon name="lucide:message-circle" class="size-7 text-secondary" aria-hidden="true" />
								) : (
									<Icon name="lucide:mail" class="size-7 text-secondary" aria-hidden="true" />
								)}
							</div>
							<div>
								<p class="font-semibold text-neutral-900">{channel.title}</p>
								<p class="text-neutral-500">{channel.subtitle}</p>
							</div>
						</a>
					))}
				</div>

				<div data-motion="fade-up" class="rounded-2xl bg-secondary/10 p-6">
					<h4 class="font-semibold text-neutral-900">Horario de atención</h4>
					<ul class="mt-4 space-y-3 text-base text-neutral-600">
						{schedule.map((entry) => (
							<li class="flex justify-between">
								<span>{entry.range}</span>
								<span class={`font-medium ${entry.dimmed ? 'text-neutral-500' : 'text-neutral-900'}`}>{entry.hours}</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</div>

	<script>
		const params = new URLSearchParams(window.location.search);
		const asunto = params.get('asunto');
		if (asunto) {
			const select = document.getElementById('subject') as HTMLSelectElement | null;
			if (select) {
				const option = Array.from(select.options).find(
					(opt) => opt.value === asunto || opt.text.toLowerCase().includes(asunto.toLowerCase()),
				);
				if (option) {
					select.value = option.value;
					select.dispatchEvent(new Event('change', { bubbles: true }));
				}
			}
			if (window.history.replaceState) {
				window.history.replaceState({}, '', window.location.pathname);
			}
		}

		const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
		const status = document.querySelector<HTMLElement>('[data-contact-status]');

		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			if (!window.cappiValidateTurnstile('contact-turnstile', 'contact-turnstile-error')) {
				if (status) status.textContent = 'Completa la verificación de seguridad para continuar.';
				return;
			}
			if (status) status.textContent = '';

			const values = new FormData(form);
			const body = [
				`Nombre: ${values.get('name') ?? ''}`,
				`Correo: ${values.get('email') ?? ''}`,
				`Asunto: ${values.get('subject') ?? ''}`,
				`Mensaje: ${values.get('message') ?? ''}`,
			].join('\n');
			window.location.href = `${WHATSAPP_URL}?text=${encodeURIComponent(body)}`;
		});
	</script>
</section>