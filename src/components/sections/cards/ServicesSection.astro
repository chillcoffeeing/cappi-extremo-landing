---
import { Image } from 'astro:assets';
import SectionHeading from '../../titles/SectionHeading.astro';

export interface Service {
	name: string;
	priceLabel: string;
	image: string;
	features: string[];
	cta: string;
}

export interface Props {
	eyebrow?: string;
	title: string;
	underline?: string;
	intro?: string;
	services: Service[];
	/** Destino de todos los CTAs de cada servicio */
	ctaHref?: string;
}

const { eyebrow = 'Nuestros servicios', title, underline, intro, services, ctaHref = '/contacto' } = Astro.props;
---

<section class="py-16 md:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<SectionHeading eyebrow={eyebrow} title={title} underline={underline} intro={intro} />

		<div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-8">
			{services.map((service) => (
				<article data-motion="fade-up" class="flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm transition-shadow hover:shadow-md">
					<div class="relative h-[250px] w-full overflow-hidden">
						<Image src={service.image} alt={service.name} width={800} height={500} loading="lazy" class="h-full w-full object-cover" />
					</div>
					<div class="flex flex-1 flex-col p-6 md:p-8">
						<h3 class="font-semibold text-neutral-900">{service.name}</h3>
						<div class="mt-3">
							<span class="text-sm font-medium text-neutral-500">{service.priceLabel}</span>
						</div>
						<ul class="mt-6 flex-1 space-y-3">
							{service.features.map((f) => (
								<li class="flex items-start gap-2 text-base text-neutral-600">
									<svg class="mt-0.5 size-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M20 6 9 17l-5-5" />
									</svg>
									{f}
								</li>
							))}
						</ul>
						<a href={ctaHref} class="mt-8 inline-flex items-center justify-center rounded-full border border-neutral-300 px-6 py-3 text-base font-semibold text-neutral-800 transition-colors hover:border-primary hover:text-primary">
							{service.cta}
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>