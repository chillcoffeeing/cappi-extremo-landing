---
import { Image } from 'astro:assets';
import SectionHeading from '../../titles/SectionHeading.astro';
import ImageAccent from '../../astro/ImageAccent.astro';
import Button from '../../buttons/Button.astro';
import { Icon } from 'astro-icon/components';

export interface Service {
	name: string;
	description?: string;
	priceLabel?: string;
	image: string;
	features: string[];
	staft: {
		director: string;
		team?: string[]
	}
	cta: string;
}

export interface Props {
	eyebrow?: string;
	title: string;
	underline?: string;
	intro?: string;
	service: Service;
	/** Destino de todos los CTAs de cada servicio */
	ctaHref?: string;
	ctaTarget?: string;
	ctaRel?: string;
}

const { eyebrow = 'Celebra con Cappi', title, underline, intro, service, ctaHref = '/contacto', ctaTarget, ctaRel } = Astro.props;
---

<section class="py-16 md:py-24">
	<div class="container">
		<SectionHeading eyebrow={eyebrow} title={title} underline={underline} intro={intro} />

		<div class="md:flex md:items-center mt-10">
			<div class="relative md:mr-8 md:w-1/2 md:flex-none overflow-hidden">
				<ImageAccent position="bottom" align="right" color="primary">
					<div class="relative overflow-hidden">
						<Image src={service.image} alt={service.name} width={800} height={500} loading="lazy" class="h-full w-full object-cover" />
					</div>
				</ImageAccent>
			</div>

			<div class="space-y-6 mt-6 md:mt-0 md:pb-10">
				{service.description && (
					<p class="text-base text-neutral-600">{service.description}</p>
				)}
				<ul class="flex-1 space-y-3">
					{service.features.map((f) => (
						<li class="flex items-start gap-2 text-base text-neutral-600">
							<Icon name="lucide:check" class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
							{f}
						</li>
					))}
				</ul>
				<p class="text-sm text-neutral-500">
					<span class="font-semibold">Directora:</span> {service.staft.director}
					{service.staft.team && ` - ${service.staft.team.join(', ')}`}
				</p>
				<Button href={ctaHref} target={ctaTarget} rel={ctaRel} class="mt-6" variant="primary" label={service.cta}></Button>
			</div>

		</div>
	</div>
</section>