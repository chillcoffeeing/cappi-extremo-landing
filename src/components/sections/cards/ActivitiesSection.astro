---
import SectionHeading from '../../titles/SectionHeading.astro';

export interface ActivityItem {
	image: string;
	title: string;
	color: string;
}

export interface Props {
	/** Encabezado de la sección */
	eyebrow?: string;
	title?: string;
	underline?: string;
	intro?: string;
	/** Tarjetas de actividad (imagen + barra de color) */
	items: ActivityItem[];
	/** Padding alto (py-16 md:py-24) vs estándar (py-12 md:py-20) */
	padding?: 'default' | 'large';
}

const { eyebrow = 'Actividades', title = '', underline, intro, items, padding = 'default' } = Astro.props;

const paddingClass = padding === 'large' ? 'py-16 md:py-24' : 'py-12 md:py-20';
---

<section class:list={[paddingClass]}>
	<div class="container">
		<SectionHeading eyebrow={eyebrow} title={title} underline={underline} intro={intro} />

		<div data-motion="fade-up" class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{items.map((item) => (
				<article class="overflow-hidden shadow-sm">
					<img
						src={item.image}
						alt={item.title}
						loading="lazy"
						decoding="async"
						class="h-40 w-full object-cover"
					/>
					<div
						class="flex h-10 items-center justify-center px-3 text-center text-lg font-semibold uppercase tracking-wide text-white"
						style={`background-color:${item.color}`}
					>
						{item.title}
					</div>
				</article>
			))}
		</div>
	</div>
</section>