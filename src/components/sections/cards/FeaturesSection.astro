---
import SectionHeading from '../../titles/SectionHeading.astro';
import { Icon } from 'astro-icon/components';

export type FeatureIcon =
	| 'dashboard'
	| 'inscription'
	| 'payments'
	| 'health'
	| 'photos'
	| 'balance';

const featureIcons: Record<FeatureIcon, string> = {
	dashboard: 'lucide:layout-dashboard',
	inscription: 'lucide:user-round-plus',
	payments: 'lucide:credit-card',
	health: 'lucide:heart',
	photos: 'lucide:image',
	balance: 'lucide:scale',
};

export type FeatureIcon =
	| 'dashboard'
	| 'inscription'
	| 'payments'
	| 'health'
	| 'photos'
	| 'balance';

export interface FeatureItem {
	icon: FeatureIcon;
	title: string;
	description: string;
}

export interface Props {
	eyebrow?: string;
	title: string;
	underline?: string;
	items: FeatureItem[];
}

const { eyebrow, title, underline, items } = Astro.props;
---

<section class="py-16 md:py-24">
	<div class="container">
		<SectionHeading eyebrow={eyebrow} title={title} underline={underline} />

		<div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{items.map((item) => (
				<article data-motion="fade-up" class="rounded-2xl border border-neutral-200 p-8 shadow-sm transition-shadow hover:shadow-md">
					<div class="flex size-12 items-center justify-center rounded-full bg-primary/10">
						<Icon name={featureIcons[item.icon]} class="size-6 text-primary" aria-hidden="true" />
					</div>
					<h3 class="mt-5 font-semibold text-neutral-900">{item.title}</h3>
					<p class="mt-2 leading-relaxed text-neutral-600">{item.description}</p>
				</article>
			))}
		</div>
	</div>
</section>