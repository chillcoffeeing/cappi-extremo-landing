---
import SectionHeading from '../../titles/SectionHeading.astro';

export type FeatureIcon =
	| 'dashboard'
	| 'inscription'
	| 'payments'
	| 'health'
	| 'photos'
	| 'balance';

export interface FeatureItem {
	icon: FeatureIcon;
	title: string;
	description: string;
}

export interface Props {
	eyebrow?: string;
	title: string;
	underline?: string;
	items: FeatureItem[];
}

const { eyebrow, title, underline, items } = Astro.props;
---

<section class="py-16 md:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<SectionHeading eyebrow={eyebrow} title={title} underline={underline} />

		<div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{items.map((item) => (
				<article data-motion="fade-up" class="rounded-2xl border border-neutral-200 p-8 shadow-sm transition-shadow hover:shadow-md">
					<div class="flex size-12 items-center justify-center rounded-full bg-primary/10">
						{item.icon === 'dashboard' && (
							<svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect width="7" height="9" x="3" y="3" rx="1" /><rect width="7" height="5" x="14" y="3" rx="1" /><rect width="7" height="9" x="14" y="12" rx="1" /><rect width="7" height="5" x="3" y="16" rx="1" />
							</svg>
						)}
						{item.icon === 'inscription' && (
							<svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" x2="19" y1="8" y2="14" /><line x1="22" x2="16" y1="11" y2="11" />
							</svg>
						)}
						{item.icon === 'payments' && (
							<svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect width="20" height="14" x="2" y="5" rx="2" /><line x1="2" x2="22" y1="10" y2="10" />
							</svg>
						)}
						{item.icon === 'health' && (
							<svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
							</svg>
						)}
						{item.icon === 'photos' && (
							<svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
							</svg>
						)}
						{item.icon === 'balance' && (
							<svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
							</svg>
						)}
					</div>
					<h3 class="mt-5 font-semibold text-neutral-900">{item.title}</h3>
					<p class="mt-2 leading-relaxed text-neutral-600">{item.description}</p>
				</article>
			))}
		</div>
	</div>
</section>