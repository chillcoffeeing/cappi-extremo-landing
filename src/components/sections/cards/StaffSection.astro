---
import SectionHeading from '../../titles/SectionHeading.astro';
import ImageAccent from '../../astro/ImageAccent.astro';

export interface Props {
	eyebrow?: string;
	title: string;
	underline?: string;
	intro?: string;
	image: string;
	imageAlt: string;
}

const { eyebrow = 'Nuestro staff', title, underline, intro, image, imageAlt } = Astro.props;
---

<section class="py-12 md:py-20">
	<div class="container">
		<SectionHeading eyebrow={eyebrow} title={title} underline={underline} intro={intro} />

		<ImageAccent color="tertiary" position="bottom" align="right">
			<img
				src={image}
				alt={imageAlt}
				loading="lazy"
				decoding="async"
				class="mt-14 w-full"
			/>
		</ImageAccent>
	</div>
</section>