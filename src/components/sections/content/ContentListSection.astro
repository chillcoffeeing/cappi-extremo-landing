---
import SectionHeading from '../../titles/SectionHeading.astro';
import { Icon } from 'astro-icon/components';

export interface ContentListItem {
	title: string;
	description?: string;
	/** Nombre del icono lucide (ej. "lucide:shield") */
	icon?: string;
}

export interface Props {
	id?: string;
	eyebrow?: string;
	title: string;
	/** Palabra del título resaltada con UnderlineStroke */
	highlight?: string;
	/** Texto posterior a la palabra resaltada */
	titleAfter?: string;
	underline?: string;
	intro?: string;
	items: ContentListItem[];
	tone?: 'light' | 'dark';
	headingColor?: 'primary' | 'secondary' | 'neutral' | 'tertiary';
}

const {
	id,
	eyebrow,
	title,
	highlight,
	titleAfter,
	underline,
	intro,
	items,
	tone = 'light',
	headingColor = 'primary',
} = Astro.props;

const sectionClass = tone === 'dark' ? 'bg-sections' : '';
const iconWrap = 'flex shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary';
---

<section id={id} class:list={['py-16 md:py-24', sectionClass]}>
	<div class="container">
		<SectionHeading eyebrow={eyebrow} title={title} underline={highlight ?? underline} afterTitle={titleAfter} intro={intro} color={headingColor} />

		<ul class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-2">
			{items.map((item) => (
				<li data-motion="fade-up" class="flex items-start gap-4">
					<span aria-hidden="true" class:list={[iconWrap, 'size-12']}>
						{item.icon ? (
							<Icon name={item.icon} class="size-6" aria-hidden="true" />
						) : (
							<span class="size-2.5 rounded-full bg-secondary"></span>
						)}
					</span>
					<div>
						<h3 class="text-neutral-900">{item.title}</h3>
						{item.description && <p class="mt-1 leading-relaxed text-neutral-600">{item.description}</p>}
					</div>
				</li>
			))}
		</ul>
	</div>
</section>