---
import SectionHeading from '../../titles/SectionHeading.astro';

export interface ContentListItem {
	title: string;
	description?: string;
}

export interface Props {
	id?: string;
	eyebrow?: string;
	title: string;
	underline?: string;
	intro?: string;
	items: ContentListItem[];
	tone?: 'light' | 'dark';
	headingColor?: 'primary' | 'secondary' | 'neutral' | 'tertiary';
	columns?: 1 | 2 | 3 | 4;
	variant?: 'list' | 'principles';
}

const {
	id,
	eyebrow,
	title,
	underline,
	intro,
	items,
	tone = 'light',
	headingColor = 'primary',
	columns = 2,
	variant = 'list',
} = Astro.props;

const sectionClass = tone === 'dark' ? 'bg-sections' : '';
const gridClass = {
	1: 'grid-cols-1',
	2: 'grid-cols-1 md:grid-cols-2',
	3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
	4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
}[columns];
const itemClass = variant === 'principles'
	? 'border-l-4 border-primary bg-white/70 px-5 py-5'
	: 'border-t border-primary/25 py-5 first:border-t-0 md:first:border-t';
---

<section id={id} class:list={['py-16 md:py-24', sectionClass]}>
	<div class="container">
		<SectionHeading eyebrow={eyebrow} title={title} underline={underline} intro={intro} color={headingColor} />

		<ul class:list={[gridClass, 'mx-auto mt-12 max-w-5xl gap-x-10 gap-y-2']}>
			{items.map((item) => (
				<li data-motion="fade-up" class={itemClass}>
					<div class="flex items-start gap-3">
						<span aria-hidden="true" class="mt-2 size-2.5 shrink-0 rounded-full bg-secondary"></span>
						<div>
							<h3 class="font-semibold text-neutral-900">{item.title}</h3>
							{item.description && <p class="mt-2 leading-relaxed text-neutral-600">{item.description}</p>}
						</div>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>
