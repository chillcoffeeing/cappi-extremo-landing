---
import SectionHeading from '../../titles/SectionHeading.astro';
import Button from '../../buttons/Button.astro';
import type { ContentListItem } from './ContentListSection.astro';

export interface Props {
	id?: string;
	eyebrow?: string;
	title: string;
	underline?: string;
	body: string;
	items?: ContentListItem[];
	ctaLabel?: string;
	ctaHref?: string;
	dialogId?: string;
	image?: string;
	imageAlt?: string;
	tone?: 'light' | 'dark';
	headingColor?: 'primary' | 'secondary' | 'neutral' | 'tertiary';
	reverse?: boolean;
}

const {
	id,
	eyebrow,
	title,
	underline,
	body,
	items = [],
	ctaLabel,
	ctaHref,
	dialogId,
	image,
	imageAlt = '',
	tone = 'light',
	headingColor = 'primary',
	reverse = false,
} = Astro.props;

const sectionClass = tone === 'dark' ? 'bg-sections' : '';
const contentOrder = reverse ? 'lg:order-2' : '';
const detailOrder = reverse ? 'lg:order-1' : '';
---

<section id={id} class:list={['py-16 md:py-24', sectionClass]}>
	<div class="container">
		<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
			<div data-motion="fade-up" class={contentOrder}>
				<SectionHeading eyebrow={eyebrow} title={title} underline={underline} color={headingColor} />
			</div>

			<div data-motion="fade-up" class:list={['max-w-2xl', detailOrder]}>
				<p class="leading-relaxed text-neutral-600">{body}</p>
				{items.length > 0 && (
					<ul class="mt-6 space-y-3">
						{items.map((item) => (
							<li class="flex items-start gap-3 text-neutral-700">
								<span aria-hidden="true" class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
								<span>
									<strong class="font-semibold text-neutral-900">{item.title}</strong>
									{item.description && <span> {item.description}</span>}
								</span>
							</li>
						))}
					</ul>
				)}
				{ctaLabel && (dialogId || ctaHref) && (
					<div class="mt-8">
						<Button
							label={ctaLabel}
							href={ctaHref}
							variant="primary"
							dataDialogTrigger={dialogId}
						/>
					</div>
				)}
				{image && <img src={image} alt={imageAlt} loading="lazy" decoding="async" class="mt-10 max-h-80 w-full object-cover" />}
			</div>
		</div>
	</div>
</section>
