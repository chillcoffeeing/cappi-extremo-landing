---
interface StaffProfile {
	name: string;
	role: string;
	bio: string;
	image?: string;
	imageAlt?: string;
}

interface Props {
	profile: StaffProfile;
	variant: 'featured' | 'small';
	/** Índice en el grid (para alternar el lado del panel en la versión grande) */
	index?: number;
}

const { profile, variant, index = 0 } = Astro.props;
const { name, role, bio } = profile;
const image = profile.image ?? '';
const imageAlt = profile.imageAlt ?? name;

const isFeatured = variant === 'featured';
const featuredSide = index % 2 === 0 ? 'details-right' : 'details-left';
---

{isFeatured ? (
	<article data-motion="fade-up" class={`staff-card-featured ${featuredSide}`}>
		<div class="staff-card-featured__portrait">
			<img src={image} alt={imageAlt} loading="lazy" decoding="async" class="staff-card-featured__img" />
		</div>
		<div class="staff-card-featured__details">
			<h4 class="staff-card-featured__name">{name}</h4>
			<p class="staff-card-featured__role">{role}</p>
			<p class="staff-card-featured__bio">{bio}</p>
		</div>
	</article>
) : (
	<article data-motion="fade-up" class="staff-card-small">
		<h4 class="staff-card-small__name">{name}</h4>
		<p class="staff-card-small__role">{role}</p>
		<p class="staff-card-small__bio">{bio}</p>
	</article>
)}

<style>
	.staff-card-small {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.35rem;
		padding: 1.25rem;
		border-radius: 1rem;
		background: #ffffff;
		box-shadow: #52525247 6px 6px 10px 0;
	}

	.staff-card-small__name {
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--color-primary);
	}

	.staff-card-small__role {
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-secondary);
	}

	.staff-card-small__bio {
		margin-top: 0.35rem;
		font-size: 0.78rem;
		line-height: 1.5;
		color: #525252;
	}

	.staff-card-featured {
		border-radius: 1rem;
		background: #ffffff;
		overflow: hidden;
		box-shadow: #52525247 6px 6px 10px 0;
	}

	.staff-card-featured__portrait {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 3;
		border: 3px solid rgba(252, 252, 252, 0.87);
		border-radius: 1rem;
		overflow: hidden;
	}

	.staff-card-featured__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.staff-card-featured__details {
		padding: 1.5rem;
	}

	.staff-card-featured__name {
		font-weight: 600;
		font-size: 1.5rem;
		color: var(--color-primary);
	}

	.staff-card-featured__role {
		margin-top: 0.25rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-secondary);
	}

	.staff-card-featured__bio {
		margin-top: 0.75rem;
		display: -webkit-box;
		overflow: hidden;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		font-size: 0.875rem;
		line-height: 1.6;
		color: #525252;
	}

	@media (min-width: 768px) {
		.staff-card-featured {
			position: relative;
			height: 24rem;
		}

		.staff-card-featured__portrait {
			position: absolute;
			top: 0;
			bottom: 0;
			height: 100%;
			width: 58%;
		}

		.staff-card-featured__details {
			position: absolute;
			top: 0;
			bottom: 0;
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: 0.5rem;
			padding: 2.5rem;
			width: 42%;
		}

		.staff-card-featured__name {
			margin: 0;
		}

		.staff-card-featured__role {
			margin-top: 0;
		}

		.staff-card-featured__bio {
			margin-top: 0;
		}

		/* Panel a la derecha: el retrato se ancla a la izquierda */
		.staff-card-featured.details-right .staff-card-featured__portrait {
			left: 0;
			right: auto;
			border-top-right-radius: 0;
			border-bottom-right-radius: 0;
		}

		.staff-card-featured.details-right .staff-card-featured__details {
			right: 0;
			background: linear-gradient(to right, transparent, #ffffff 32%);
		}

		/* Panel a la izquierda: el retrato se ancla a la derecha */
		.staff-card-featured.details-left .staff-card-featured__portrait {
			left: auto;
			right: 0;
			border-top-left-radius: 0;
			border-bottom-left-radius: 0;
		}

		.staff-card-featured.details-left .staff-card-featured__details {
			left: 0;
			background: linear-gradient(to left, transparent, #ffffff 32%);
		}
	}
</style>