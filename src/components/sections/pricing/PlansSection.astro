---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../../titles/SectionHeading.astro';
import PriceDisplay from '../../price-components/PriceDisplay.astro';
import Button from '../../buttons/Button.astro';

export interface Plan {
	name: string;
	price: string;
	period: string;
	startDate?: string;
	features: string[];
	cta: string;
	highlight?: boolean;
	disabled?: boolean;
	image: ImageMetadata;
	slug: string;
}

export interface Props {
	eyebrow?: string;
	title: string;
	underline?: string;
	intro?: string;
	plans: Plan[];
	/** Destino del CTA de cada plan (salvo disabled) */
	inscribirHref?: string;
}

const { eyebrow = 'Nuestros planes', title, underline, intro, plans, inscribirHref = '/coming-soon' } = Astro.props;
---

<section class="py-16 md:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<SectionHeading eyebrow={eyebrow} title={title} underline={underline} intro={intro} />

		<div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
			{plans.map((plan) => (
				<article data-motion="fade-up" class:list={[
					'relative flex flex-col overflow-hidden rounded-2xl border shadow-sm transition-shadow hover:shadow-md',
					plan.highlight ? 'border-primary bg-primary/5' : 'border-neutral-200 bg-white',
				]}>
					{plan.highlight && (
						<span class="absolute left-4 top-4 z-10 rounded-full bg-primary px-4 py-1 text-xs font-semibold uppercase text-primary-foreground">
							Más popular
						</span>
					)}
					<div class="relative h-[250px] w-full overflow-hidden">
						<Image src={plan.image} alt={plan.name} width={800} height={500} loading="lazy" class="h-full w-full object-cover" />
					</div>
					<div class="flex flex-1 flex-col p-6 md:p-8">
						<h3 class="font-semibold text-neutral-900">{plan.name}</h3>
						{plan.startDate && (
							<p class="mt-1 font-medium uppercase tracking-wide text-neutral-500">Fecha de inicio: {plan.startDate}</p>
						)}
						<div class="mt-3">
							<PriceDisplay price={plan.price} period={plan.period} style="inline" />
						</div>
						<ul class="mt-6 flex-1 space-y-3">
							{plan.features.map((f) => (
								<li class="flex items-start gap-2 text-base text-neutral-600">
									<svg class="mt-0.5 size-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M20 6 9 17l-5-5" />
									</svg>
									{f}
								</li>
							))}
						</ul>
						<div class="mt-8 flex flex-col items-start gap-3">
							{plan.disabled ? (
								<Button label={plan.cta} type="button" variant="outline" disabled />
							) : (
								<Button
									label={plan.cta}
									href={inscribirHref}
									variant={plan.highlight ? 'primary' : 'outline'}
									size="sm"
								/>
							)}
							<a href={`/planes-vacacionales/${plan.slug}`}
								class="text-sm font-medium uppercase text-neutral-500 transition-colors hover:text-primary">
								Ver detalles del plan vacacional
							</a>
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>