---
import SectionHeading from '../../titles/SectionHeading.astro';
import GalleryCarousel from '../../react/GalleryCarousel.tsx';

export interface GalleryImage {
	src: string;
	alt: string;
}

export interface Row {
	images: GalleryImage[];
	direction: 'left' | 'right';
}

export interface Props {
	eyebrow?: string;
	title: string;
	underline?: string;
	intro?: string;
	/** Clases extra para el intro (ej. max-w-[700px]) */
	introClass?: string;
	rows: Row[];
	padding?: 'default' | 'large';
}

const { eyebrow = 'Galería', title, underline, intro, introClass = '', rows, padding = 'large' } = Astro.props;

const paddingClass = padding === 'large' ? 'py-16 md:py-24' : 'py-12 md:py-20';
---

<section class={paddingClass}>
	<div class="container">
		<SectionHeading eyebrow={eyebrow} title={title} underline={underline} intro={intro} introClass={introClass} />

		<div class="mt-14 space-y-4 sm:space-y-6">
			{rows.map((row) => (
				<GalleryCarousel client:visible images={row.images} direction={row.direction} />
			))}
		</div>
	</div>
</section>