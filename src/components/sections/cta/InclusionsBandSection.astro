---
import UnderlineStroke from '../../titles/UnderlineStroke.astro';
import SectionPattern from '../../astro/SectionPattern.astro';
import Button from '../../buttons/Button.astro';
import { Icon } from 'astro-icon/components';

export interface Pill {
	text: string;
	fat?: boolean;
}

export interface IncludedItem {
	label: string;
	icon: string;
}

interface Props {
	/** Encabezado de la sección */
	eyebrow?: string;
	title?: string;
	underline?: string;
	intro?: string;
	/** Píldoras de horario/sede/edad */
	pills: Pill[];
	/** Ubicación bajo las píldoras */
	location: string;
	/** Ítems incluidos (nombre de ícono astro-icon: local o lucide:*) */
	items: IncludedItem[];
	cta: { label: string; href: string };
}

const { eyebrow = 'Plan vacacional', title = '¿Qué incluye?', underline, intro = '', pills, location, items, cta } = Astro.props;
---

<section class="relative isolate bg-sections">
	<div class="container py-16 md:py-24">
		{(eyebrow || title) && (
			<div data-motion="fade-up" class="text-center">
				{eyebrow && <p class="font-semibold uppercase tracking-widest text-primary/80">{eyebrow}</p>}
				<h2 class="mt-3 font-semibold uppercase md:leading-tight">
					{title}
					{underline && <UnderlineStroke color="text-secondary">{underline}</UnderlineStroke>}
				</h2>
			</div>
		)}
		{intro && (
			<p data-motion="fade-up" class="mx-auto mt-4 max-w-[700px] text-center leading-relaxed text-primary/90">
				{intro}
			</p>
		)}

		<div data-motion="fade-up" class="mt-12 flex flex-col items-center gap-3 md:flex-row md:justify-center md:gap-0">
			{pills.map((p, i) => (
				<div
					class:list={[
						'flex items-center justify-center rounded-full border-4 border-white/70 bg-primary px-6 py-3 text-center text-base font-semibold text-white md:rounded-xl',
						p.fat ? 'h-18 text-lg sm:px-10 sm:py-4 sm:text-lg' : 'h-12 ' + (i === 0 ? 'md:rounded-l-full md:border-r-0' : 'md:rounded-r-full md:border-l-0'),
					]}
				>
					{p.text}
				</div>
			))}
		</div>

		<p data-motion="fade-up" class="mt-8 text-center font-semibold text-primary">{location}</p>

		<div data-motion="fade-up" class="mt-14 justify-center flex flex-wrap gap-3 sm:gap-6">
			{items.map((item) => (
				<div class="flex items-center flex-col w-40 md:w-50 gap-4 rounded-2xl text-center bg-white p-6">
					<div class="flex size-26 items-center justify-center rounded-full bg-primary/20 text-primary">
						<Icon name={item.icon} class="size-10" aria-hidden="true" />
					</div>
					<p class="font-semibold text-primary">{item.label}</p>
				</div>
			))}
		</div>

		<div data-motion="fade-up" class="mt-12 flex justify-center">
			<Button label={cta.label} href={cta.href} variant="primary" />
		</div>
	</div>

</section>