---
import SectionHeading from '../../titles/SectionHeading.astro';
import Testimonials from '../../react/Testimonials.tsx';
import type { Testimonial } from '../../../data/testimonials';

export interface Props {
	eyebrow?: string;
	title: string;
	underline?: string;
	items: Testimonial[];
	padding?: 'default' | 'large';
	/** Título pegado al carrusel (h2 con mb-6, sin wrapper mt-14) */
	compactHeading?: boolean;
}

const {
	eyebrow = 'Testimonios',
	title,
	underline,
	items,
	padding = 'default',
	compactHeading = false,
} = Astro.props;

const paddingClass = padding === 'large' ? 'py-16 md:py-24' : 'py-12 md:py-20';

const headingClass = compactHeading ? 'mb-6' : '';
const wrapperClass = compactHeading ? '' : 'mt-14';
---

<section class={paddingClass}>
	<div class="container">
		<SectionHeading eyebrow={eyebrow} title={title} underline={underline} titleClass={headingClass} />

		<div class={wrapperClass}>
			<Testimonials client:visible items={items} />
		</div>
	</div>
</section>