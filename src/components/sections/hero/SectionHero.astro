---
import Button from '../../buttons/Button.astro';
import type { ButtonProps } from '../../buttons/Button.astro';
import UnderlineStroke from '../../titles/UnderlineStroke.astro';
import { Icon } from 'astro-icon/components';

export interface Crumb {
	label: string;
	href?: string;
}

export interface Props {
	/** Imagen de fondo (cubren toda la sección) */
	bgImage?: string;
	/** Gradiente de fondo (clases tailwind, ej. bg-gradient-to-br from-primary to-secondary). Reemplaza la imagen */
	bgGradient?: string;
	/** Video de fondo opcional (supera la imagen) */
	bgVideo?: string;
	/** Posición del video de fondo (ej. "center", "top", "bottom") */
	bgMediaPosition?: 'center' | 'top' | 'bottom';
	/** Poster para el video */
	bgVideoPoster?: string;
	/** Color de fondo */
	bgColor?: string;
	/** Texto corto sobre el título */
	eyebrow?: string;
	/** Fragmento del eyebrow */
	eyebrowHighlight?: string;
	/** Título h1 */
	title: string;
	/** Fragmento del título */
	highlight?: string;
	/** Texto posterior al fragmento resaltado */
	titleAfter?: string;
	/** Subtítulo */
	subtitle?: string;
	/** Píldora informativa bajo el subtítulo (ej. "100% personalizable") */
	badge?: string;
	/** Botones CTA */
	buttons?: Array<ButtonProps & { dialogId?: string; }>;
	/** Migas de pan opcionales (ej. detalle de plan) */
	crumbs?: Crumb[];
	/** Hero de pantalla completa (home) en vez de banda con padding */
	dock?: boolean;
	/** Margen superior del h1 (false cuando hay breadcrumb) */
	titleMargin?: boolean;
	/** Disfuminado lateral */
	disfuminar?: 'top' | 'bottom';
}

const {
	bgImage,
	bgGradient,
	bgMediaPosition = 'center',
	bgVideo,
	bgVideoPoster,
	bgColor,
	eyebrow,
	eyebrowHighlight,
	title,
	highlight,
	titleAfter = '',
	subtitle,
	badge,
	buttons = [],
	crumbs = [],
	dock = false,
	titleMargin = true,
	disfuminar,
} = Astro.props;

const innerClass = [
	'flex flex-col items-center justify-center text-center',
	'-translate-y-4 sm:-translate-y-6 lg:-translate-y-[60px]',
	dock ? 'py-4 lg:py-10' : '',
].filter(Boolean).join(' ');

const contentClass = [
	'mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8',
].filter(Boolean).join(' ');

const titleClass = [
	'text-[2rem] sm:text-[2.5rem] lg:text-[3rem] font-bold tracking-tight text-white',
	titleMargin && 'mt-2 lg:mt-4',
	dock ? 'max-w-4xl' : 'max-w-3xl',
].filter(Boolean).join(' ');

const ctasClass = 'mt-6 sm:mt-8 flex flex-col items-center gap-3 sm:gap-4 sm:flex-row';

const disfuminarClass = disfuminar === 'top' ? 'diffuminar-top' : disfuminar === 'bottom' ? 'diffuminar-bottom' : '';

const bgMediaPositionClass = bgMediaPosition === 'top' ? 'object-top' : bgMediaPosition === 'bottom' ? 'object-bottom' : 'object-center';
---

<div class="relative isolate z-1 flex flex-col justify-center min-h-[320px] sm:min-h-[416px] lg:min-h-[685px] xl:min-h-[785px] 2xl:min-h-[992px] overflow-hidden" class:list={[bgColor]}>
	{bgGradient ? (
		<div aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full" class:list={[bgGradient, disfuminarClass]} />
	) : bgVideo ? (
			<video poster={bgVideoPoster} preload="none" autoplay muted loop class=" absolute inset-0 -z-10 h-full w-full object-cover brightness-50" class:list={[disfuminarClass, bgMediaPositionClass]}>
				<source src={bgVideo} type="video/mp4" />
			</video>
		) : (
			<img src={bgImage} alt="" aria-hidden="true" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover brightness-50" class:list={[disfuminarClass, bgMediaPositionClass]} />
		)
	}

	<div class={contentClass}>
		<div class={innerClass}>
			{crumbs.length > 0 && (
				<nav data-motion="fade-up" aria-label="Breadcrumb" class="mb-6">
					<ol class="flex items-center gap-2 text-sm text-white/70">
						{
							crumbs.map((crumb, i) => (
								<Fragment>
									{i > 0 && <li aria-hidden="true">/</li>}
									<li>
										{crumb.href ? (
											<a href={crumb.href} class="transition-colors hover:text-white">{crumb.label}</a>
										) : (
											<span class="text-white">{crumb.label}</span>
										)}
									</li>
								</Fragment>
							))
						}
					</ol>
				</nav>
			)}

			{(eyebrow || eyebrowHighlight) && (
				<p data-motion="fade-up" class="font-semibold uppercase tracking-wide text-white">
					{eyebrow}
					{eyebrowHighlight && <span>{eyebrowHighlight}</span>}
				</p>
			)}

			<h1 data-motion="fade-up" class={titleClass}>
				{title}
				{highlight && <UnderlineStroke color="text-secondary">{highlight}</UnderlineStroke>}
				{titleAfter}
			</h1>

			{subtitle && (
				<p data-motion="fade-up" class="mt-4 sm:mt-6 max-w-2xl font-normal leading-relaxed text-white">
					{subtitle}
				</p>
			)}

			{badge && (
				<div data-motion="fade-up" class="mt-6 sm:mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold uppercase text-primary-foreground">
					<Icon name="lucide:sparkle" class="size-5" aria-hidden="true" />
					{badge}
				</div>
			)}

			{buttons.length > 0 && (
				<div data-motion="fade-up" class={ctasClass}>
					{buttons.map((button) => (
						<Button label={button.label} href={button.href} variant={button.variant ?? 'primary'} target={button.target} rel={button.rel} dataDialogTrigger={button.dialogId} textColor={button.textColor} bgColor={button.bgColor} borderColor={button.borderColor} />
					))}
				</div>
			)}
		</div>
	</div>
</div>
