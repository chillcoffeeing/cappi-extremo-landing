---
import Button from '../../buttons/Button.astro';

export interface Link {
	label: string;
	href: string;
	variant?: 'primary' | 'link';
}

export interface Props {
	title?: string;
	description?: string;
	links?: Link[];
}

const {
	title = 'Próximamente',
	description = 'El portal de familias está en desarrollo. Pronto tendrás acceso a inscripciones, pagos, galería de fotos y todo lo que necesitas para seguir la aventura de tu hijo.',
	links = [
		{ label: 'Volver al inicio', href: '/', variant: 'primary' },
		{ label: 'Conoce qué incluye el portal', href: '/familias', variant: 'link' },
	],
} = Astro.props;
---

<section class="flex min-h-[70vh] items-center justify-center py-24">
	<div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
		<div data-motion="fade-up" class="mx-auto max-w-lg">
			<div class="mx-auto flex size-24 items-center justify-center rounded-full bg-primary/10">
				<svg class="size-12 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
					<circle cx="12" cy="12" r="3" />
				</svg>
			</div>

			<h1 class="mt-8 font-semibold text-neutral-900">
				{title}
			</h1>
			<p class="mt-5 leading-relaxed text-neutral-600">
				{description}
			</p>

			<div class="mt-10 flex flex-col items-center gap-4">
				{links.map((link) =>
					link.variant === 'link' ? (
						<a href={link.href} class="text-sm font-medium uppercase text-neutral-500 transition-colors hover:text-primary">
							{link.label}
						</a>
					) : (
						<Button label={link.label} href={link.href} variant="primary" />
					),
				)}
			</div>
		</div>
	</div>
</section>