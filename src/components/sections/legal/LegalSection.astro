---
export interface LegalSection {
	heading: string;
	/** Cuerpo HTML (párrafos separados por <br> o con enlaces inline) */
	body?: string;
	list?: string[];
}

export interface Props {
	title: string;
	updated: string;
	sections: LegalSection[];
}

const { title, updated, sections } = Astro.props;
---

<section class="py-12 md:py-20">
	<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
		<h1 data-motion="fade-up" class="font-semibold text-neutral-900">
			{title}
		</h1>
		<p data-motion="fade-up" class="mt-2 text-neutral-500">{updated}</p>

		<div data-motion="fade-up" class="prose prose-neutral mt-8 max-w-none space-y-6 text-base leading-relaxed text-neutral-600">
			{sections.map((section) => (
				<section>
					<h2 class="font-semibold text-neutral-900">{section.heading}</h2>
					{section.body && <p set:html={section.body} />}
					{section.list && (
						<ul class="mt-3 list-inside list-disc space-y-1">
							{section.list.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					)}
				</section>
			))}
		</div>
	</div>
</section>