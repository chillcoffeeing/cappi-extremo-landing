---
interface Props {
	id: string;
}

const { id } = Astro.props;
---

<div class="flex flex-col gap-4" >
	<div
		id={id}
		data-turnstile-widget
		data-turnstile-error-id={`${id}-error`}
		aria-label="Verificación de seguridad Cloudflare"
		class="max-w-max"
	></div>
	<p id={`${id}-error`} data-turnstile-error class="hidden text-sm text-red-600" role="alert">
		Completa la verificación de seguridad para continuar.
	</p>
</div>