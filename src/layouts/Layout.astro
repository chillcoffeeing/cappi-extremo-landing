---
import "../styles/global.css";
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";
import { Icon } from "astro-icon/components";
import { WHATSAPP_URL } from "../lib/social";

interface Props {
	title?: string;
	description?: string;
}

const { title = "Cappi Extremo", description = "Las vacaciones más divertidas para tu hijo. Planes vacacionales, fiestas y eventos infantiles." } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://www.cappixtremo.com");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImageUrl = new URL("/og-image.jpg", siteUrl);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:site_name" content="Cappi Xtremo" />
		<meta property="og:locale" content="es_VE" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Vacaciones extremas con Cappi Xtremo" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,900;1,700&family=Inter:wght@300;400&family=Sansita+One&family=Sansita+Swashed:wght@900&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			window.cappiTurnstileSitekey = '0x4AAAAAAEvEKN72adJsrspz';

			const cappiRenderTurnstileWidgets = () => {
				const t = window.turnstile;
				if (!t) return;
				document.querySelectorAll('[data-turnstile-widget]').forEach((container) => {
					if (container.dataset.turnstileRendered === '1') return;
					container.dataset.turnstileRendered = '1';
					const errorEl = container.dataset.turnstileErrorId
						? document.getElementById(container.dataset.turnstileErrorId)
						: null;
					t.render(container, {
						sitekey: window.cappiTurnstileSitekey,
						hl: 'es',
						size: 'flexible',
						callback: () => errorEl?.classList.add('hidden'),
						'error-callback': () => errorEl?.classList.remove('hidden'),
					});
				});
			};

			window.onloadTurnstileCallback = cappiRenderTurnstileWidgets;
			document.addEventListener('modal:open', () => {
				window.setTimeout(cappiRenderTurnstileWidgets, 0);
			});

			window.cappiValidateTurnstile = (widgetId, errorId) => {
				const container = document.getElementById(widgetId);
				const error = errorId ? document.getElementById(errorId) : null;
				if (!container || !window.turnstile) {
					error?.classList.add('hidden');
					return true;
				}
				const token = window.turnstile.getResponse(container);
				if (!token) {
					error?.classList.remove('hidden');
					return false;
				}
				error?.classList.add('hidden');
				return true;
			};

			// F-052 (B-4): el token de Turnstile solo se comprueba en el cliente
			// (no hay backend: el formulario abre WhatsApp/correo), así que un
			// segundo envío reutilizaría el mismo token ya "consumido". Tras cada
			// envío se reinicia el widget y se exige una verificación nueva.
			window.cappiResetTurnstile = (widgetId) => {
				const container = document.getElementById(widgetId);
				if (!container || !window.turnstile) return;
				try {
					window.turnstile.reset(container);
				} catch {
					// widget aún no renderizado: nada que reiniciar
				}
			};
		</script>
		<script
			src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onloadTurnstileCallback"
			defer
		></script>
		<title>{title}</title>
	</head>
	<body class="flex min-h-dvh flex-col overflow-x-hidden">
		<Header />
		
		<main class="flex-1">
			<slot />
		</main>
		<a
			href={WHATSAPP_URL}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Contactar por WhatsApp"
			title="Contactar por WhatsApp"
			class="opacity-95 fixed bottom-6 right-6 z-50 inline-flex size-14 items-center justify-center rounded-full bg-[#25D366] text-primary-foreground shadow-lg transition-transform hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
		>
<Icon name="lucide:message-circle" class="size-7" aria-hidden="true" />
		</a>
		<Footer />
		<script>
			import "../scripts/reveal";
		</script>
	</body>
</html>
